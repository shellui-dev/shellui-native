<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- The Avalonia components in the browser, one per URL, for the live previews on the docs site.
       Needs the wasm-tools workload: dotnet workload install wasm-tools -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AvaloniaPreview</RootNamespace>
    <!-- No ICU data: it is the largest single download after the runtime. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The components are the demo's own files, so a preview can never drift from them. -->
  <ItemGroup>
    <Compile Include="..\Avalonia.Demo\Components\UI\**\*.cs" LinkBase="Components\UI" />
  </ItemGroup>

  <!-- Previews are loaded by name at run time, which the trimmer can't follow. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="AvaloniaPreview" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>
</Project>
