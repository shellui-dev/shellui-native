<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI.Demo.Pages.CardsPage"
             Title="Cards">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <Label Text="Card Components" FontSize="24" FontAttributes="Bold" />
            <Label Text="Coming soon: Card with Header, Title, Description, Content, and Footer."
                   TextColor="{StaticResource ShellUIMutedForeground}" />

            <!-- Placeholder for future card components -->
            <Frame BackgroundColor="{StaticResource ShellUISecondary}"
                   BorderColor="{StaticResource ShellUIBorder}"
                   CornerRadius="8"
                   Padding="40">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="🃏" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Card components coming soon" 
                           FontSize="16" 
                           HorizontalOptions="Center" />
                    <Label Text="Card, CardHeader, CardTitle, CardContent, CardFooter" 
                           FontSize="14" 
                           TextColor="{StaticResource ShellUIMutedForeground}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
