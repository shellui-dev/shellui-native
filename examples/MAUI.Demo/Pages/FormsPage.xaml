<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI.Demo.Pages.FormsPage"
             Title="Forms">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <Label Text="Form Components" FontSize="24" FontAttributes="Bold" />
            <Label Text="Coming soon: Input, Label, Checkbox, Switch, and more form components."
                   TextColor="{StaticResource ShellUIMutedForeground}" />

            <!-- Placeholder for future form components -->
            <Frame BackgroundColor="{StaticResource ShellUISecondary}"
                   BorderColor="{StaticResource ShellUIBorder}"
                   CornerRadius="8"
                   Padding="40">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="🚧" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Form components coming soon" 
                           FontSize="16" 
                           HorizontalOptions="Center" />
                    <Label Text="Input, Checkbox, Switch, Select, etc." 
                           FontSize="14" 
                           TextColor="{StaticResource ShellUIMutedForeground}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
