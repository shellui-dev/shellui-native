<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:MAUI.Demo.Components.UI"
             xmlns:icons="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             x:Class="MAUI.Demo.MainPage"
             Title="ShellUI Native Demo">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header with Theme Toggle -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="ShellUI Native" 
                           FontSize="32" 
                           FontAttributes="Bold" />
                    <Label Text="Component Demo" 
                           FontSize="16" 
                           TextColor="Gray" />
                </VerticalStackLayout>
                
                <ui:ThemeToggle x:Name="ThemeToggleSwitch" 
                                Grid.Column="1" 
                                VerticalOptions="Center" />
            </Grid>

            <!-- Badges Section -->
            <Label Text="Badges" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                <ui:Badge Text="Default" Variant="Default" />
                <ui:Badge Text="Success" Variant="Success" />
                <ui:Badge Text="Warning" Variant="Warning" />
                <ui:Badge Text="Error" Variant="Destructive" />
            </HorizontalStackLayout>

            <!-- Buttons Section -->
            <Label Text="Buttons" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:Button Text="Default Button" Variant="Default" Clicked="OnButtonClicked" />
                <ui:Button Text="Secondary Button" Variant="Secondary" Clicked="OnButtonClicked" />
                <ui:Button Text="Outline Button" Variant="Outline" Clicked="OnButtonClicked" />
                <ui:Button Text="Destructive Button" Variant="Destructive" Clicked="OnButtonClicked" />
                <ui:Button Text="Ghost Button" Variant="Ghost" Clicked="OnButtonClicked" />
            </VerticalStackLayout>

            <!-- Buttons with Icons -->
            <Label Text="Buttons with Icons" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:Button Text="Add Item" 
                           Variant="Default" 
                           Icon="{x:Static icons:FluentIcons.Add24}" 
                           Clicked="OnButtonClicked" />
                <ui:Button Text="Search" 
                           Variant="Secondary" 
                           Icon="{x:Static icons:FluentIcons.Search24}" 
                           Clicked="OnButtonClicked" />
                <ui:Button Text="Settings" 
                           Variant="Outline" 
                           Icon="{x:Static icons:FluentIcons.Settings24}" 
                           Clicked="OnButtonClicked" />
                <ui:Button Text="Delete" 
                           Variant="Destructive" 
                           Icon="{x:Static icons:FluentIcons.Delete24}" 
                           Clicked="OnButtonClicked" />
                <ui:Button Text="Continue" 
                           Variant="Default" 
                           Icon="{x:Static icons:FluentIcons.ArrowRight24}" 
                           IconPosition="Right"
                           Clicked="OnButtonClicked" />
            </VerticalStackLayout>

            <!-- Icon-only Buttons -->
            <Label Text="Icon-only Buttons" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Start">
                <ui:Button Variant="Outline" 
                           Icon="{x:Static icons:FluentIcons.Heart24}" 
                           Size="Sm"
                           Clicked="OnButtonClicked" />
                <ui:Button Variant="Outline" 
                           Icon="{x:Static icons:FluentIcons.Share24}" 
                           Size="Sm"
                           Clicked="OnButtonClicked" />
                <ui:Button Variant="Outline" 
                           Icon="{x:Static icons:FluentIcons.Bookmark24}" 
                           Size="Sm"
                           Clicked="OnButtonClicked" />
                <ui:Button Variant="Default" 
                           Icon="{x:Static icons:FluentIcons.Add24}" 
                           Size="Sm"
                           Clicked="OnButtonClicked" />
            </HorizontalStackLayout>

            <!-- Button Sizes -->
            <Label Text="Button Sizes" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Start">
                <ui:Button Text="Small" Variant="Default" Size="Sm" Clicked="OnButtonClicked" />
                <ui:Button Text="Default" Variant="Default" Size="Default" Clicked="OnButtonClicked" />
                <ui:Button Text="Large" Variant="Default" Size="Lg" Clicked="OnButtonClicked" />
            </HorizontalStackLayout>

            <!-- Loading Button -->
            <Label Text="Loading State" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Button x:Name="LoadingBtn" Text="Click to Load" Variant="Default" Clicked="OnLoadingClicked" />

            <!-- Input Section -->
            <Label Text="Inputs" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:Input x:Name="NameInput" Placeholder="Enter your name..." />
                <ui:Input Placeholder="Password" IsPassword="True" />
                <ui:Input Placeholder="Error state" HasError="True" />
                <ui:Input Placeholder="Read only" Text="Can't edit this" IsReadOnly="True" />
            </VerticalStackLayout>

            <!-- Labels Section -->
            <Label Text="ShellLabel Variants" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="8">
                <ui:ShellLabel Text="Default Label" Variant="Default" />
                <ui:ShellLabel Text="Muted Label" Variant="Muted" />
                <ui:ShellLabel Text="Destructive Label" Variant="Destructive" />
                <ui:ShellLabel Text="Success Label" Variant="Success" />
                <ui:ShellLabel Text="Warning Label" Variant="Warning" />
            </VerticalStackLayout>

            <!-- Label Sizes -->
            <Label Text="Label Sizes" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="4">
                <ui:ShellLabel Text="Extra Small (Xs)" Size="Xs" />
                <ui:ShellLabel Text="Small (Sm)" Size="Sm" />
                <ui:ShellLabel Text="Default" Size="Default" />
                <ui:ShellLabel Text="Large (Lg)" Size="Lg" />
                <ui:ShellLabel Text="Extra Large (Xl)" Size="Xl" />
            </VerticalStackLayout>

            <!-- Status Label -->
            <Label x:Name="StatusLabel" 
                   Text="Click a button to see events!" 
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,20,0,40" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
