                        <ui:TreeViewItem Text="Components" Icon="Folder" IsExpanded="True">
                            <ui:TreeViewItem Text="Button.cs" Icon="File" />
                            <ui:TreeViewItem Text="Card.cs" Icon="File" />
                            <ui:TreeViewItem Text="Dialog.cs" Icon="File" />
                        </ui:TreeViewItem>
                        <ui:TreeViewItem Text="Resources" Icon="Folder">
                            <ui:TreeViewItem Text="appicon.svg" Icon="Image" />
                        </ui:TreeViewItem>
                        <ui:TreeViewItem Text="MainPage.xaml" Icon="FileText" />
                        <ui:TreeViewItem Text="App.xaml" Icon="FileText" />
                    </ui:TreeViewItem>
                    <ui:TreeViewItem Text="README.md" Icon="FileText" />
                </ui:TreeView>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GroupData" Spacing="16" IsVisible="False">
                <!-- Carousel -->
                <Label Text="Carousel" Style="{StaticResource SectionTitle}" />
                <ui:Carousel x:Name="CarouselDemo" AspectRatio="2.4" WidthRequest="{OnIdiom Phone=-1, Default=560}"
                             HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}"
                             PositionChanged="OnCarouselChanged">
                    <Grid BackgroundColor="{DynamicResource ShellUIMuted}">
                        <Label Text="1" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </Grid>
                    <Grid BackgroundColor="{DynamicResource ShellUISecondary}">
                        <Label Text="2" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </Grid>
                    <Grid BackgroundColor="{DynamicResource ShellUIAccent}">
                        <Label Text="3" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </Grid>
                    <Grid BackgroundColor="{DynamicResource ShellUIMuted}">
                        <Label Text="4" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </Grid>
                </ui:Carousel>

                <!-- Aspect ratio -->
                <Label Text="Aspect Ratio" Style="{StaticResource SectionTitle}" />
                <ui:AspectRatio Ratio="1.7778" WidthRequest="{OnIdiom Phone=-1, Default=360}"
                                HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource ShellUIMuted}">
                        <Label Text="16 : 9" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIMutedForeground}" />
                    </Border>
                </ui:AspectRatio>

                <!-- Skeleton -->
                <Label Text="Skeleton" Style="{StaticResource SectionTitle}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <ui:Skeleton WidthRequest="48" HeightRequest="48" CornerRadius="24" />
                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <ui:Skeleton HeightRequest="16" WidthRequest="250" HorizontalOptions="Start" />
                        <ui:Skeleton HeightRequest="16" WidthRequest="200" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Table -->
                <Label Text="Table" Style="{StaticResource SectionTitle}" />
                <ui:Table Columns="*,*,1.4*,90" MinimumContentWidth="440" Caption="A list of your recent invoices.">
                    <ui:TableHeader>
                        <ui:TableHead Text="Invoice" />
                        <ui:TableHead Text="Status" />
                        <ui:TableHead Text="Method" />
                        <ui:TableHead Text="Amount" HorizontalTextAlignment="End" />
                    </ui:TableHeader>
                    <ui:TableRow Tapped="OnTableRowTapped">
                        <ui:TableCell Text="INV001" IsBold="True" />
                        <ui:TableCell><ui:Badge Text="Paid" Variant="Success" HorizontalOptions="Start" VerticalOptions="Center" /></ui:TableCell>
                        <ui:TableCell Text="Credit Card" />
                        <ui:TableCell Text="$250.00" HorizontalTextAlignment="End" />
                    </ui:TableRow>
                    <ui:TableRow Tapped="OnTableRowTapped">
                        <ui:TableCell Text="INV002" IsBold="True" />
                        <ui:TableCell><ui:Badge Text="Pending" Variant="Warning" HorizontalOptions="Start" VerticalOptions="Center" /></ui:TableCell>
                        <ui:TableCell Text="PayPal" />
                        <ui:TableCell Text="$150.00" HorizontalTextAlignment="End" />
                    </ui:TableRow>
                    <ui:TableRow Tapped="OnTableRowTapped">
                        <ui:TableCell Text="INV003" IsBold="True" />
                        <ui:TableCell><ui:Badge Text="Unpaid" Variant="Destructive" HorizontalOptions="Start" VerticalOptions="Center" /></ui:TableCell>
                        <ui:TableCell Text="Bank Transfer" />
                        <ui:TableCell Text="$350.00" HorizontalTextAlignment="End" />
                    </ui:TableRow>
                    <ui:TableRow Tapped="OnTableRowTapped">
                        <ui:TableCell Text="INV004" IsBold="True" />
                        <ui:TableCell><ui:Badge Text="Paid" Variant="Success" HorizontalOptions="Start" VerticalOptions="Center" /></ui:TableCell>
                        <ui:TableCell Text="Credit Card" />
                        <ui:TableCell Text="$450.00" HorizontalTextAlignment="End" />
                    </ui:TableRow>
                </ui:Table>

                <!-- Image viewer -->
                <Label Text="Image Viewer" Style="{StaticResource SectionTitle}" />
                <HorizontalStackLayout Spacing="12">
                    <ui:ImageViewer x:Name="ImageViewerDemo" Source="shellui_native.png" Description="The ShellUI Native mark"
                                    WidthRequest="120" HeightRequest="120" />
                    <ui:ImageViewer Source="shellui.png" Description="The ShellUI mark" WidthRequest="120" HeightRequest="120" />
                    <ui:ImageViewer Source="shellicons.png" Description="The ShellIcons mark" WidthRequest="120" HeightRequest="120" />
                </HorizontalStackLayout>

                <!-- Chat -->
                <Label Text="Chat" Style="{StaticResource SectionTitle}" />
                <ui:Chat x:Name="ChatDemo" HeightRequest="420" WidthRequest="{OnIdiom Phone=-1, Default=520}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}">
                    <ui:Chat.Header>
                        <HorizontalStackLayout Spacing="8">
                            <ui:Icon Name="Sparkles" Size="18" VerticalOptions="Center" />
                            <Label Text="ShellUI assistant" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"
                                   TextColor="{DynamicResource ShellUIForeground}" />
                        </HorizontalStackLayout>
                    </ui:Chat.Header>
                    <ui:ChatMessage Role="System" Text="This conversation is a demo." />
                    <ui:ChatMessage Role="Assistant" Sender="ShellUI" Timestamp="09:41" AvatarText="S" Text="Hi! Ask me about any component." />
                    <ui:ChatMessage Role="User" Sender="Shewart" Timestamp="09:42" AvatarText="SS" Text="How do I add the data table?" />
                    <ui:ChatMessage Role="Assistant" Sender="ShellUI" Timestamp="09:42" AvatarText="S" Text="Run the command below, then bind ItemsSource to your list.">
                        <ui:Kbd Text="shellui-native add data-table" HorizontalOptions="Start" />
                    </ui:ChatMessage>
                    <ui:Chat.Footer>
                        <ui:ChatInput x:Name="ChatInputDemo" Submitted="OnChatSubmitted" />
                    </ui:Chat.Footer>
                </ui:Chat>

                <!-- Data table -->
                <Label Text="Data Table" Style="{StaticResource SectionTitle}" />
                <ui:DataTable x:Name="DataTableDemo" ShowSelection="True" PageSize="5" MinimumContentWidth="560"
                              SelectionChanged="OnDataTableSelection" RowTapped="OnDataTableRow">
                    <ui:DataTableColumn Header="Invoice" Property="Number" IsBold="True" Width="110" />
                    <ui:DataTableColumn Header="Customer" Property="Customer" Width="1.4*" />
                    <ui:DataTableColumn Header="Status" Property="Status" />
                    <ui:DataTableColumn Header="Date" Property="Date" Format="MMM d, yyyy" />
                    <ui:DataTableColumn Header="Amount" Property="Amount" Format="C" Width="120" HorizontalTextAlignment="End" />
                </ui:DataTable>

                <!-- Empty state -->
                <Label Text="Empty State" Style="{StaticResource SectionTitle}" />
                <ui:EmptyState Icon="Folder" Title="No projects yet" Bordered="True"
                               Description="You haven't created any projects. Get started by creating your first one.">
                    <ui:Button Text="Create project" Icon="Plus" Clicked="OnButtonClicked" />
                    <ui:Button Text="Import" Variant="Outline" Clicked="OnButtonClicked" />
                </ui:EmptyState>

                <!-- Timeline -->
                <Label Text="Timeline" Style="{StaticResource SectionTitle}" />
                <ui:Timeline>
                    <ui:TimelineItem Title="Order placed" Time="09:12" Text="We received your order and sent a confirmation." />
                    <ui:TimelineItem Title="Payment confirmed" Time="09:14" Icon="CreditCard" Text="Charged to the card ending in 4242." />
                    <ui:TimelineItem Title="Shipped" Time="14:40" Icon="Send" IsActive="True">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Your parcel is on its way." FontSize="14" TextColor="{DynamicResource ShellUIMutedForeground}" />
                            <ui:Badge Text="In transit" Variant="Info" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </ui:TimelineItem>
                    <ui:TimelineItem Title="Delivered" Text="Expected tomorrow." />
                </ui:Timeline>

                <!-- Scroll area -->
                <Label Text="Scroll Area" Style="{StaticResource SectionTitle}" />
                <Border StrokeThickness="1" Stroke="{DynamicResource ShellUIBorderBrush}"
                        StrokeShape="RoundRectangle 6" WidthRequest="240" HorizontalOptions="Start">
                    <ui:ScrollArea HeightRequest="180">
                        <VerticalStackLayout x:Name="TagList" Padding="16" Spacing="8">
                            <Label Text="Tags" Style="{StaticResource FieldLabel}" />
                        </VerticalStackLayout>
                    </ui:ScrollArea>
                </Border>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GroupCharts" Spacing="16" IsVisible="False">
                <!-- Charts -->
                <Label Text="Charts" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Bar chart" Description="Two series side by side." />
                    <ui:CardContent>
                <ui:BarChart x:Name="BarChartDemo" Labels="Jan, Feb, Mar, Apr, May, Jun" Description="Visitors by month, desktop and mobile" HeightRequest="260">
                <ui:ChartSeries Name="Desktop" Values="186, 305, 237, 73, 209, 214" />
                <ui:ChartSeries Name="Mobile" Values="80, 200, 120, 190, 130, 140" />
                </ui:BarChart>
                    </ui:CardContent>
                </ui:Card>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Stacked bars" Description="IsStacked puts the series on top of each other." />
                    <ui:CardContent>
                <ui:BarChart Labels="Jan, Feb, Mar, Apr, May, Jun" IsStacked="True" HeightRequest="260">
                <ui:ChartSeries Name="Desktop" Values="186, 305, 237, 73, 209, 214" />
                <ui:ChartSeries Name="Mobile" Values="80, 200, 120, 190, 130, 140" />
                </ui:BarChart>
                    </ui:CardContent>
                </ui:Card>
                </ui:WrapLayout>
                <ui:WrapLayout>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Horizontal bars" Description="IsHorizontal lays the bars down; negative values go the other way." />
                    <ui:CardContent>
                <ui:BarChart Labels="Chrome, Safari, Firefox, Edge, Other" IsHorizontal="True" ShowLegend="False" HeightRequest="260">
                <ui:ChartSeries Name="Change" Values="12, -5, 8, -3, 4" />
                </ui:BarChart>
                    </ui:CardContent>
                </ui:Card>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Line chart" Description="Smooth by default, with a dot on every point here." />
                    <ui:CardContent>
                <ui:LineChart x:Name="LineChartDemo" Labels="Jan, Feb, Mar, Apr, May, Jun" ShowDots="True" HeightRequest="260">
                <ui:ChartSeries Name="Desktop" Values="186, 305, 237, 73, 209, 214" />
                <ui:ChartSeries Name="Mobile" Values="80, 200, 120, 190, 130, 140" />
                </ui:LineChart>
                    </ui:CardContent>
                </ui:Card>
                </ui:WrapLayout>
                <ui:WrapLayout>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Area chart" Description="Stacked, each series sits on the one before it." />
                    <ui:CardContent>
                <ui:AreaChart Labels="Jan, Feb, Mar, Apr, May, Jun" IsStacked="True" HeightRequest="260">
                <ui:ChartSeries Name="Desktop" Values="186, 305, 237, 73, 209, 214" />
                <ui:ChartSeries Name="Mobile" Values="80, 200, 120, 190, 130, 140" />
                </ui:AreaChart>
                    </ui:CardContent>
                </ui:Card>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Straight lines" Description="IsSmooth off, and a fixed value axis." />
                    <ui:CardContent>
                <ui:AreaChart Labels="Jan, Feb, Mar, Apr, May, Jun" IsSmooth="False" Maximum="400" ValueFormat="0" HeightRequest="260">
                <ui:ChartSeries Name="Desktop" Values="186, 305, 237, 73, 209, 214" />
                </ui:AreaChart>
                    </ui:CardContent>
                </ui:Card>
                </ui:WrapLayout>
                <ui:WrapLayout>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Pie chart" Description="One slice per value, named by Labels." />
                    <ui:CardContent>
                <ui:PieChart x:Name="PieChartDemo" Labels="Chrome, Safari, Firefox, Edge, Other" HeightRequest="260">
                <ui:ChartSeries Values="275, 200, 187, 173, 90" />
                </ui:PieChart>
                    </ui:CardContent>
                </ui:Card>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Donut chart" Description="A pie with a hole for a value and a label." />
                    <ui:CardContent>
                <ui:DonutChart Labels="Chrome, Safari, Firefox, Edge, Other" CenterValue="925" CenterLabel="Visitors" HeightRequest="260">
                <ui:ChartSeries Values="275, 200, 187, 173, 90" />
                </ui:DonutChart>
                    </ui:CardContent>
                </ui:Card>
                </ui:WrapLayout>
                <ui:WrapLayout>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Radar chart" Description="A spoke per category and a shape per series." />
                    <ui:CardContent>
                <ui:RadarChart x:Name="RadarChartDemo" Labels="Speed, Power, Range, Comfort, Price, Safety" HeightRequest="280">
                <ui:ChartSeries Name="Model A" Values="80, 65, 90, 70, 55, 85" />
                <ui:ChartSeries Name="Model B" Values="60, 85, 70, 80, 75, 65" />
                </ui:RadarChart>
                    </ui:CardContent>
                </ui:Card>
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=420}" Margin="0,0,16,16">
                    <ui:CardHeader Title="Radial chart" Description="A ring per value, filling towards Maximum." />
                    <ui:CardContent>
                <ui:RadialChart x:Name="RadialChartDemo" Labels="Move, Exercise, Stand" Maximum="100" CenterValue="72%" CenterLabel="Move" HeightRequest="260">
                <ui:ChartSeries Values="72, 48, 90" />
                </ui:RadialChart>
                    </ui:CardContent>
                </ui:Card>
                </ui:WrapLayout>
                </VerticalStackLayout>

                <ui:Separator Margin="0,24,0,0" />
                <Label Text="Built with ShellUI Native." Style="{StaticResource Muted}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
