<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:MAUI.Demo.Components.UI"
             xmlns:icons="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             x:Class="MAUI.Demo.MainPage"
             Title="ShellUI Native Demo">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header with Theme Toggle -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="ShellUI Native" 
                           FontSize="32" 
                           FontAttributes="Bold" />
                    <Label Text="Component Demo" 
                           FontSize="16" 
                           TextColor="Gray" />
                </VerticalStackLayout>
                
                <ui:ThemeToggle x:Name="ThemeToggleSwitch" 
                                Grid.Column="1" 
                                VerticalOptions="Center" />
            </Grid>

            <!-- Badges Section -->
            <Label Text="Badges" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                <ui:Badge Text="Default" Variant="Default" />
                <ui:Badge Text="Success" Variant="Success" />
                <ui:Badge Text="Warning" Variant="Warning" />
                <ui:Badge Text="Error" Variant="Destructive" />
            </HorizontalStackLayout>

            <!-- Buttons Section -->
            <Label Text="Buttons" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:Button Text="Default Button" Variant="Default" Clicked="OnButtonClicked" />
                <ui:Button Text="Secondary Button" Variant="Secondary" Clicked="OnButtonClicked" />
                <ui:Button Text="Outline Button" Variant="Outline" Clicked="OnButtonClicked" />
                <ui:Button Text="Destructive Button" Variant="Destructive" Clicked="OnButtonClicked" />
                <ui:Button Text="Ghost Button" Variant="Ghost" Clicked="OnButtonClicked" />
            </VerticalStackLayout>

            <!-- Buttons with Icons -->
            <Label Text="Buttons with Icons" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:Button Text="Add Item" 
                           Variant="Default" 
                           Icon="{x:Static icons:FluentIcons.Add24}" 
                           Clicked="OnButtonClicked" />
                <ui:Button Text="Search" 
                           Variant="Secondary" 
                           Icon="{x:Static icons:FluentIcons.Search24}" 
                           Clicked="OnButtonClicked" />
                <ui:Button Text="Settings" 
                           Variant="Outline" 
                           Icon="{x:Static icons:FluentIcons.Settings24}" 
                           Clicked="OnButtonClicked" />
                <ui:Button Text="Delete" 
                           Variant="Destructive" 
                           Icon="{x:Static icons:FluentIcons.Delete24}" 
                           Clicked="OnButtonClicked" />
                <ui:Button Text="Continue" 
                           Variant="Default" 
                           Icon="{x:Static icons:FluentIcons.ArrowRight24}" 
                           IconPosition="Right"
                           Clicked="OnButtonClicked" />
            </VerticalStackLayout>

            <!-- Icon-only Buttons -->
            <Label Text="Icon-only Buttons" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Start">
                <ui:Button Variant="Outline" 
                           Icon="{x:Static icons:FluentIcons.Heart24}" 
                           Size="Sm"
                           Clicked="OnButtonClicked" />
                <ui:Button Variant="Outline" 
                           Icon="{x:Static icons:FluentIcons.Share24}" 
                           Size="Sm"
                           Clicked="OnButtonClicked" />
                <ui:Button Variant="Outline" 
                           Icon="{x:Static icons:FluentIcons.Bookmark24}" 
                           Size="Sm"
                           Clicked="OnButtonClicked" />
                <ui:Button Variant="Default" 
                           Icon="{x:Static icons:FluentIcons.Add24}" 
                           Size="Sm"
                           Clicked="OnButtonClicked" />
            </HorizontalStackLayout>

            <!-- Button Sizes -->
            <Label Text="Button Sizes" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Start">
                <ui:Button Text="Small" Variant="Default" Size="Sm" Clicked="OnButtonClicked" />
                <ui:Button Text="Default" Variant="Default" Size="Default" Clicked="OnButtonClicked" />
                <ui:Button Text="Large" Variant="Default" Size="Lg" Clicked="OnButtonClicked" />
            </HorizontalStackLayout>

            <!-- Loading Button -->
            <Label Text="Loading State" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Button x:Name="LoadingBtn" Text="Click to Load" Variant="Default" Clicked="OnLoadingClicked" />

            <!-- Input Section -->
            <Label Text="Inputs" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:Input x:Name="NameInput" Placeholder="Enter your name..." />
                <ui:Input Placeholder="Password" IsPassword="True" />
                <ui:Input Placeholder="Error state" HasError="True" />
                <ui:Input Placeholder="Read only" Text="Can't edit this" IsReadOnly="True" />
            </VerticalStackLayout>

            <!-- Labels Section -->
            <Label Text="ShellLabel Variants" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="8">
                <ui:ShellLabel Text="Default Label" Variant="Default" />
                <ui:ShellLabel Text="Muted Label" Variant="Muted" />
                <ui:ShellLabel Text="Destructive Label" Variant="Destructive" />
                <ui:ShellLabel Text="Success Label" Variant="Success" />
                <ui:ShellLabel Text="Warning Label" Variant="Warning" />
            </VerticalStackLayout>

            <!-- Label Sizes -->
            <Label Text="Label Sizes" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="4">
                <ui:ShellLabel Text="Extra Small (Xs)" Size="Xs" />
                <ui:ShellLabel Text="Small (Sm)" Size="Sm" />
                <ui:ShellLabel Text="Default" Size="Default" />
                <ui:ShellLabel Text="Large (Lg)" Size="Lg" />
                <ui:ShellLabel Text="Extra Large (Xl)" Size="Xl" />
            </VerticalStackLayout>

            <!-- Card -->
            <Label Text="Card" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Card Variant="Elevated">
                <ui:CardHeader Title="Card Title" Description="Optional description" />
                <ui:CardContent>
                    <Label Text="Card body content goes here. Use CardHeader, CardContent, CardFooter." />
                </ui:CardContent>
                <ui:CardFooter>
                    <ui:Button Text="Action" Clicked="OnButtonClicked" />
                </ui:CardFooter>
            </ui:Card>

            <!-- Separator -->
            <Label Text="Separator" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Separator Orientation="Horizontal" />

            <!-- Checkbox & Switch -->
            <Label Text="Checkbox &amp; Switch" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:Checkbox x:Name="CheckDemo" Label="Accept terms" IsChecked="True" />
                <ui:Switch x:Name="SwitchDemo" Label="Enable notifications" IsToggled="True" />
            </VerticalStackLayout>

            <!-- Progress -->
            <Label Text="Progress" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:Progress Value="75" Maximum="100" ShowLabel="True" />
                <ui:Progress Value="50" Variant="Success" />
            </VerticalStackLayout>

            <!-- Alert -->
            <Label Text="Alert" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="8">
                <ui:Alert Title="Success!" Message="Operation completed" Variant="Success" />
                <ui:Alert Title="Warning" Message="Please review" Variant="Warning" />
            </VerticalStackLayout>

            <!-- P2 Form: Textarea, Slider, Select, RadioGroup, DatePicker, TimePicker -->
            <Label Text="Textarea" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Textarea x:Name="NotesInput" Placeholder="Enter notes..." />

            <Label Text="Slider" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Slider x:Name="VolumeSlider" Value="50" Minimum="0" Maximum="100" />

            <Label Text="Select" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Select x:Name="CountrySelect" SelectedIndex="0" />

            <Label Text="Radio Group" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:RadioGroup x:Name="RadioGroupDemo">
                <ui:RadioGroupItem Value="a" Text="Option A" />
                <ui:RadioGroupItem Value="b" Text="Option B" />
                <ui:RadioGroupItem Value="c" Text="Option C" />
            </ui:RadioGroup>

            <Label Text="Date &amp; Time Picker" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="12">
                <ui:DatePicker x:Name="DatePickerDemo" />
                <ui:TimePicker x:Name="TimePickerDemo" />
            </VerticalStackLayout>

            <!-- Overlays: Dialog, Drawer, Sheet, Dropdown, Popover -->
            <Label Text="Dialog" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Dialog x:Name="DemoDialog" OpenChanged="OnDialogOpenChanged">
                <ui:DialogTrigger>
                    <ui:Button Text="Open Dialog" Clicked="OnDialogTriggerClicked" />
                </ui:DialogTrigger>
                <ui:DialogContent>
                    <ui:DialogHeader>
                        <ui:DialogTitle Text="Dialog Title" />
                        <ui:DialogDescription Text="This is a modal dialog." />
                    </ui:DialogHeader>
                    <Label Text="Modal content appears here." />
                    <ui:DialogFooter>
                        <ui:Button Text="Close" Clicked="OnDialogClose" />
                    </ui:DialogFooter>
                </ui:DialogContent>
            </ui:Dialog>

            <Label Text="Drawer" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Drawer x:Name="DemoDrawer" Side="Bottom">
                <ui:DrawerTrigger>
                    <ui:Button Text="Open Drawer" Clicked="OnDrawerTriggerClicked" />
                </ui:DrawerTrigger>
                <ui:DrawerContent>
                    <Label Text="Drawer content - slide from bottom" FontAttributes="Bold" />
                </ui:DrawerContent>
            </ui:Drawer>

            <Label Text="Sheet" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Sheet x:Name="DemoSheet" Side="Right">
                <ui:SheetTrigger>
                    <ui:Button Text="Open Sheet" Clicked="OnSheetTriggerClicked" />
                </ui:SheetTrigger>
                <ui:SheetContent>
                    <Label Text="Sheet content" FontAttributes="Bold" />
                </ui:SheetContent>
            </ui:Sheet>

            <Label Text="Dropdown" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Dropdown>
                <ui:DropdownTrigger>
                    <ui:Button Text="Menu" Clicked="OnButtonClicked" />
                </ui:DropdownTrigger>
                <ui:DropdownContent>
                    <ui:DropdownItem Text="Option 1" Clicked="OnDropdownItem" />
                    <ui:DropdownItem Text="Option 2" Clicked="OnDropdownItem" />
                </ui:DropdownContent>
            </ui:Dropdown>

            <Label Text="Popover" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Popover>
                <ui:PopoverTrigger>
                    <ui:Button Text="Show Info" Clicked="OnButtonClicked" />
                </ui:PopoverTrigger>
                <ui:PopoverContent>
                    <Label Text="Popover content - floating panel" />
                </ui:PopoverContent>
            </ui:Popover>

            <!-- ================================================================ -->
            <!-- P3: Navigation / Layout                                        -->
            <!-- ================================================================ -->

            <Label Text="Collapsible" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Collapsible>
                <ui:CollapsibleTrigger>
                    <ui:Button Text="Show details" Variant="Outline" Clicked="OnButtonClicked" />
                </ui:CollapsibleTrigger>
                <ui:CollapsibleContent>
                    <ui:Card Margin="0,8,0,0">
                        <ui:CardContent>
                            <Label Text="Hidden content revealed on toggle. Fades in over 150ms." />
                        </ui:CardContent>
                    </ui:Card>
                </ui:CollapsibleContent>
            </ui:Collapsible>

            <Label Text="Accordion (Single)" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Accordion Type="Single">
                <ui:AccordionItem Value="a">
                    <ui:AccordionTrigger>
                        <Label Text="Section A" FontAttributes="Bold" VerticalOptions="Center" />
                    </ui:AccordionTrigger>
                    <ui:AccordionContent>
                        <Label Text="A's body — opening B will close this in Single mode." Margin="0,4,0,8" />
                    </ui:AccordionContent>
                </ui:AccordionItem>
                <ui:Separator />
                <ui:AccordionItem Value="b">
                    <ui:AccordionTrigger>
                        <Label Text="Section B" FontAttributes="Bold" VerticalOptions="Center" />
                    </ui:AccordionTrigger>
                    <ui:AccordionContent>
                        <Label Text="B's body." Margin="0,4,0,8" />
                    </ui:AccordionContent>
                </ui:AccordionItem>
                <ui:Separator />
                <ui:AccordionItem Value="c">
                    <ui:AccordionTrigger>
                        <Label Text="Section C" FontAttributes="Bold" VerticalOptions="Center" />
                    </ui:AccordionTrigger>
                    <ui:AccordionContent>
                        <Label Text="C's body." Margin="0,4,0,8" />
                    </ui:AccordionContent>
                </ui:AccordionItem>
            </ui:Accordion>

            <Label Text="Tabs" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Tabs Value="overview">
                <ui:TabsList>
                    <ui:TabsTrigger Value="overview" Text="Overview" />
                    <ui:TabsTrigger Value="details" Text="Details" />
                    <ui:TabsTrigger Value="activity" Text="Activity" />
                </ui:TabsList>
                <ui:Separator Margin="0,0,0,12" />
                <ui:TabsContent Value="overview">
                    <Label Text="Overview panel — active tab underlines in Primary blue." />
                </ui:TabsContent>
                <ui:TabsContent Value="details">
                    <Label Text="Details panel — instant swap, no fade to avoid glitchy rapid clicks." />
                </ui:TabsContent>
                <ui:TabsContent Value="activity">
                    <Label Text="Activity panel." />
                </ui:TabsContent>
            </ui:Tabs>

            <Label Text="Breadcrumb" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:Breadcrumb>
                <ui:BreadcrumbItem Text="Home" Clicked="OnBreadcrumbClicked" />
                <ui:BreadcrumbItem Text="Library" Clicked="OnBreadcrumbClicked" />
                <ui:BreadcrumbItem Text="Data" Clicked="OnBreadcrumbClicked" />
                <ui:BreadcrumbItem Text="Current Page" IsCurrent="True" />
            </ui:Breadcrumb>

            <Label Text="Skeleton (loading state)" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <VerticalStackLayout Spacing="8">
                <ui:Skeleton HeightRequest="20" WidthRequest="200" />
                <ui:Skeleton HeightRequest="16" />
                <ui:Skeleton HeightRequest="16" WidthRequest="260" />
                <ui:Skeleton HeightRequest="60" CornerRadius="8" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <Label Text="ScrollArea" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10" />
            <ui:ScrollArea HeightRequest="140">
                <VerticalStackLayout Spacing="6" Padding="0,0,8,0">
                    <Label Text="Line 1 — vertical scroll wrapper" />
                    <Label Text="Line 2" />
                    <Label Text="Line 3" />
                    <Label Text="Line 4" />
                    <Label Text="Line 5" />
                    <Label Text="Line 6" />
                    <Label Text="Line 7" />
                    <Label Text="Line 8" />
                    <Label Text="Line 9" />
                    <Label Text="Line 10 — end of list" />
                </VerticalStackLayout>
            </ui:ScrollArea>

            <!-- Status Label -->
            <Label x:Name="StatusLabel"
                   Text="Click a button to see events!"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,20,0,40" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
