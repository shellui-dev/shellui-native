<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:MAUI.Demo.Components.UI"
             x:Class="MAUI.Demo.MainPage"
             Shell.NavBarIsVisible="False"
             Title="ShellUI Native"
             BackgroundColor="{DynamicResource ShellUIBackground}">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource ShellUIForeground}" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="SectionHint" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{DynamicResource ShellUIMutedForeground}" />
            <Setter Property="Margin" Value="0,-8,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource ShellUIForeground}" />
        </Style>
        <Style x:Key="Body" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{DynamicResource ShellUIForeground}" />
        </Style>
        <Style x:Key="Muted" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{DynamicResource ShellUIMutedForeground}" />
        </Style>
        <!-- Rows of buttons: children carry their own margins. -->
        <Style TargetType="ui:WrapLayout">
            <Setter Property="Spacing" Value="0" />
            <Setter Property="LineSpacing" Value="0" />
        </Style>
    </ContentPage.Resources>

    <!-- The header stays put; one category of components shows at a time. A single page with
         every component on it is too much for one layout pass on Windows (see docs/COMPONENTS.md,
         "Long pages on Windows"). Overlays are declared next to their triggers: ShellUI floats
         them in a page-level layer. -->
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="24,24,24,0" Spacing="12" MaximumWidthRequest="760">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Label Text="ShellUI Native" FontSize="30" FontAttributes="Bold"
                           TextColor="{DynamicResource ShellUIForeground}" />
                    <Label Text="Beautifully designed components for .NET MAUI" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <ui:ThemeToggle x:Name="ThemeToggleSwitch" Grid.Column="1" VerticalOptions="Start" />
            </Grid>
            <Label x:Name="StatusLabel" Text="Interact with a component to see its events here."
                   Style="{StaticResource Muted}" FontSize="13" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="36">
                <ui:ToggleGroup x:Name="CategoryPicker" Value="buttons" ValueChanged="OnCategoryChanged">
                    <ui:ToggleGroupItem Value="buttons" Text="Buttons" />
                    <ui:ToggleGroupItem Value="forms" Text="Forms" />
                    <ui:ToggleGroupItem Value="feedback" Text="Feedback" />
                    <ui:ToggleGroupItem Value="overlays" Text="Overlays" />
                    <ui:ToggleGroupItem Value="navigation" Text="Navigation" />
                    <ui:ToggleGroupItem Value="data" Text="Data" />
                </ui:ToggleGroup>
            </ScrollView>
            <ui:Separator />
        </VerticalStackLayout>

        <ScrollView x:Name="PageScroll" Grid.Row="1">
            <VerticalStackLayout Padding="24,16,24,48" Spacing="16" MaximumWidthRequest="760">

                <VerticalStackLayout x:Name="GroupButtons" Spacing="16">
                <!-- Button -->
                <Label Text="Button" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:Button Text="Default" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Secondary" Variant="Secondary" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Outline" Variant="Outline" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Destructive" Variant="Destructive" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Ghost" Variant="Ghost" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Link" Variant="Link" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                </ui:WrapLayout>
                <ui:WrapLayout>
                    <ui:Button Text="Small" Size="Sm" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Default" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Large" Size="Lg" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="New item" Icon="Plus" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Continue" Icon="ArrowRight" IconPosition="Right" Variant="Outline" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Text="Delete" Icon="Trash2" Variant="Destructive" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                </ui:WrapLayout>
                <ui:WrapLayout>
                    <ui:Button Icon="Heart" Size="Icon" Variant="Outline" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Icon="Share2" Size="Icon" Variant="Outline" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Icon="Bookmark" Size="Icon" Variant="Outline" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button Icon="Settings" Size="Icon" Variant="Ghost" Margin="0,0,8,8" Clicked="OnButtonClicked" />
                    <ui:Button x:Name="LoadingBtn" Text="Click to load" Variant="Secondary" Margin="0,0,8,8" Clicked="OnLoadingClicked" />
                </ui:WrapLayout>

                <!-- Toggle -->
                <Label Text="Toggle" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:Toggle Icon="Star" Margin="0,0,8,8" PressedChanged="OnTogglePressed" />
                    <ui:Toggle Icon="Bookmark" Variant="Outline" IsPressed="True" Margin="0,0,8,8" PressedChanged="OnTogglePressed" />
                    <ui:Toggle Text="Bold" Variant="Outline" Margin="0,0,8,8" PressedChanged="OnTogglePressed" />
                    <ui:Toggle Text="Notify me" Icon="Bell" Size="Sm" Margin="0,0,8,8" PressedChanged="OnTogglePressed" />
                </ui:WrapLayout>

                <!-- Toggle group -->
                <Label Text="Toggle Group" Style="{StaticResource SectionTitle}" />
                <ui:ToggleGroup x:Name="ViewToggleGroup" Value="week" ValueChanged="OnToggleGroupChanged">
                    <ui:ToggleGroupItem Value="day" Text="Day" />
                    <ui:ToggleGroupItem Value="week" Text="Week" />
                    <ui:ToggleGroupItem Value="month" Text="Month" />
                </ui:ToggleGroup>
                <ui:ToggleGroup Multiple="True" Variant="Outline" ValuesChanged="OnToggleGroupValues">
                    <ui:ToggleGroupItem Value="star" Icon="Star" />
                    <ui:ToggleGroupItem Value="heart" Icon="Heart" />
                    <ui:ToggleGroupItem Value="bookmark" Icon="Bookmark" />
                </ui:ToggleGroup>

                <!-- Badge -->
                <Label Text="Badge" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:Badge Text="Default" Margin="0,0,8,8" />
                    <ui:Badge Text="Secondary" Variant="Secondary" Margin="0,0,8,8" />
                    <ui:Badge Text="Outline" Variant="Outline" Margin="0,0,8,8" />
                    <ui:Badge Text="Destructive" Variant="Destructive" Margin="0,0,8,8" />
                    <ui:Badge Text="Success" Variant="Success" Margin="0,0,8,8" />
                    <ui:Badge Text="Warning" Variant="Warning" Margin="0,0,8,8" />
                    <ui:Badge Text="Info" Variant="Info" Margin="0,0,8,8" />
                </ui:WrapLayout>

                <!-- Kbd -->
                <Label Text="Kbd" Style="{StaticResource SectionTitle}" />
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Open search with" Style="{StaticResource Muted}" FontSize="14" VerticalOptions="Center" />
                    <ui:Kbd Text="Ctrl" />
                    <ui:Kbd Text="K" />
                    <Label Text="or close with" Style="{StaticResource Muted}" FontSize="14" VerticalOptions="Center" />
                    <ui:Kbd Text="Esc" />
                </HorizontalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GroupForms" Spacing="16" IsVisible="False">
                <!-- Input -->
                <Label Text="Input" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="8">
                    <Label Text="Email" Style="{StaticResource FieldLabel}" />
                    <ui:Input x:Name="NameInput" Placeholder="you@example.com" Keyboard="Email" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Password" Style="{StaticResource FieldLabel}" />
                    <ui:Input Placeholder="••••••••" IsPassword="True" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Username" Style="{StaticResource FieldLabel}" />
                    <ui:Input Placeholder="Username" Text="taken-name" HasError="True" />
                    <ui:ShellLabel Text="This username is already taken." Size="Sm" Variant="Destructive" />
                </VerticalStackLayout>
                <ui:Input Text="Read-only value" IsReadOnly="True" />

                <!-- Input OTP -->
                <Label Text="Input OTP" Style="{StaticResource SectionTitle}" />
                <ui:InputOtp x:Name="OtpDemo" Length="6" Completed="OnOtpCompleted" />

                <!-- Number input -->
                <Label Text="Number Input" Style="{StaticResource SectionTitle}" />
                <ui:NumberInput x:Name="QuantityInput" Value="2" Minimum="0" Maximum="10" WidthRequest="160"
                                HorizontalOptions="Start" ValueChanged="OnNumberChanged" />

                <!-- Tag input -->
                <Label Text="Tag Input" Style="{StaticResource SectionTitle}" />
                <ui:TagInput x:Name="TagsInput" Placeholder="Add a label and press Enter..." MaxTags="6" TagsChanged="OnTagsChanged" />

                <!-- Textarea -->
                <Label Text="Textarea" Style="{StaticResource SectionTitle}" />
                <ui:Textarea x:Name="NotesInput" Placeholder="Type your message here." />

                <!-- Select -->
                <Label Text="Select" Style="{StaticResource SectionTitle}" />
                <ui:Select x:Name="CountrySelect" Placeholder="Select a country" WidthRequest="280"
                           HorizontalOptions="Start" SelectedIndexChanged="OnSelectChanged" />

                <!-- Combobox -->
                <Label Text="Combobox" Style="{StaticResource SectionTitle}" />
                <ui:Combobox x:Name="FrameworkCombobox" Placeholder="Select framework..." SearchPlaceholder="Search framework..."
                             WidthRequest="280" HorizontalOptions="Start" ValueChanged="OnComboboxChanged" />

                <!-- Checkbox / Switch / Radio -->
                <Label Text="Checkbox, Switch, Radio Group" Style="{StaticResource SectionTitle}" />
                <ui:Checkbox x:Name="CheckDemo" Label="Accept terms and conditions" IsChecked="True" CheckedChanged="OnCheckChanged" />
                <ui:Switch x:Name="SwitchDemo" Label="Airplane mode" Toggled="OnSwitchToggled" />
                <ui:RadioGroup x:Name="RadioGroupDemo" Value="comfortable" ValueChanged="OnRadioChanged">
                    <ui:RadioGroupItem Value="default" Text="Default" />
                    <ui:RadioGroupItem Value="comfortable" Text="Comfortable" />
                    <ui:RadioGroupItem Value="compact" Text="Compact" />
                </ui:RadioGroup>

                <!-- Slider / Progress -->
                <Label Text="Slider &amp; Progress" Style="{StaticResource SectionTitle}" />
                <ui:Slider x:Name="VolumeSlider" Value="40" Minimum="0" Maximum="100" ValueChanged="OnSliderChanged" />
                <ui:Progress x:Name="ProgressDemo" Value="40" ShowLabel="True" />
                <ui:Progress Value="72" Variant="Success" />

                <!-- Date / Time -->
                <Label Text="Date &amp; Time" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:DatePicker x:Name="DatePickerDemo" Margin="0,0,8,8" DateChanged="OnDateChanged" />
                    <ui:TimePicker x:Name="TimePickerDemo" Time="9:30" Is24Hour="False" Margin="0,0,8,8" TimeChanged="OnTimeChanged" />
                    <ui:TimePicker Time="18:45" Is24Hour="True" MinuteStep="15" Margin="0,0,8,8" TimeChanged="OnTimeChanged" />
                </ui:WrapLayout>

                <Label Text="Calendar" Style="{StaticResource SectionTitle}" />
                <Border StrokeThickness="1" Stroke="{DynamicResource ShellUIBorderBrush}" StrokeShape="RoundRectangle 6"
                        Padding="12" HorizontalOptions="Start">
                    <ui:Calendar x:Name="CalendarDemo" DateSelected="OnCalendarSelected" />
                </Border>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GroupFeedback" Spacing="16" IsVisible="False">
                <!-- Card -->
                <Label Text="Card" Style="{StaticResource SectionTitle}" />
                <ui:Card WidthRequest="{OnIdiom Phone=-1, Default=380}"
                         HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}">
                    <ui:CardHeader Title="Create project" Description="Deploy your new project in one click." />
                    <ui:CardContent>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Name" Style="{StaticResource FieldLabel}" />
                            <ui:Input Placeholder="Name of your project" />
                        </VerticalStackLayout>
                    </ui:CardContent>
                    <ui:CardFooter>
                        <ui:Button Text="Cancel" Variant="Outline" Clicked="OnButtonClicked" />
                        <ui:Button Text="Deploy" Clicked="OnButtonClicked" />
                    </ui:CardFooter>
                </ui:Card>

                <!-- Stat card -->
                <Label Text="Stat Card" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:StatCard Title="Total revenue" Value="$45,231.89" Change="+20.1%" Trend="Up" Icon="DollarSign"
                                 Description="from last month" WidthRequest="230" Margin="0,0,12,12" />
                    <ui:StatCard Title="Churn" Value="2.4%" Change="-0.6%" Trend="Down" Icon="Users"
                                 Description="from last month" WidthRequest="230" Margin="0,0,12,12" />
                    <ui:StatCard Title="Active now" Value="573" Change="steady" Icon="Activity"
                                 WidthRequest="230" Margin="0,0,12,12" />
                </ui:WrapLayout>

                <!-- Alert -->
                <Label Text="Alert" Style="{StaticResource SectionTitle}" />
                <ui:Alert Title="Heads up!" Message="You can add components to your app using the CLI." />
                <ui:Alert Title="Error" Message="Your session has expired. Please log in again." Variant="Destructive" />
                <ui:Alert Title="Saved" Message="Your changes were saved." Variant="Success" />
                <ui:Alert Title="Storage almost full" Message="You have used 92% of your quota." Variant="Warning" />

                <!-- Callout -->
                <Label Text="Callout" Style="{StaticResource SectionTitle}" />
                <ui:Callout Title="Note" Text="Components are copied into your project, so you own the code and can change anything." />
                <ui:Callout Variant="Tip" Title="Tip" Text="Press Escape (or Back on Android) to close the overlay on top." />
                <ui:Callout Variant="Warning" Title="Warning" Text="Re-running add with --force overwrites your local edits." />
                <ui:Callout Variant="Danger" Title="Danger">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Deleting a workspace removes every project in it." FontSize="14"
                               TextColor="{DynamicResource ShellUIForeground}" />
                        <ui:Button Text="Review projects" Variant="Outline" Size="Sm" HorizontalOptions="Start" Clicked="OnButtonClicked" />
                    </VerticalStackLayout>
                </ui:Callout>
                <ui:Callout Variant="Default" Text="A neutral callout without a title." />

                <!-- Toast -->
                <Label Text="Toast" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:Button Text="Show toast" Variant="Outline" Margin="0,0,8,8" Clicked="OnToastDefault" />
                    <ui:Button Text="Success" Variant="Outline" Margin="0,0,8,8" Clicked="OnToastSuccess" />
                    <ui:Button Text="Error" Variant="Outline" Margin="0,0,8,8" Clicked="OnToastError" />
                    <ui:Button Text="Warning" Variant="Outline" Margin="0,0,8,8" Clicked="OnToastWarning" />
                    <ui:Button Text="Info" Variant="Outline" Margin="0,0,8,8" Clicked="OnToastInfo" />
                    <ui:Button Text="With action" Variant="Outline" Margin="0,0,8,8" Clicked="OnToastAction" />
                </ui:WrapLayout>

                <!-- Avatar & Spinner -->
                <Label Text="Avatar" Style="{StaticResource SectionTitle}" />
                <HorizontalStackLayout Spacing="12">
                    <ui:Avatar Source="dotnet_bot.png" Fallback="DB" />
                    <ui:Avatar Fallback="CN" />
                    <ui:Avatar />
                    <ui:Avatar Fallback="SM" Size="Sm" />
                    <ui:Avatar Fallback="LG" Size="Lg" />
                    <ui:Avatar Source="dotnet_bot.png" Size="Xl" />
                </HorizontalStackLayout>

                <Label Text="Spinner" Style="{StaticResource SectionTitle}" />
                <HorizontalStackLayout Spacing="16">
                    <ui:Spinner Size="Sm" />
                    <ui:Spinner />
                    <ui:Spinner Size="Lg" Token="MutedForeground" />
                    <ui:Button Text="Saving" IsLoading="True" Variant="Secondary" />
                </HorizontalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GroupOverlays" Spacing="16" IsVisible="False">
                <!-- Overlays -->
                <Label Text="Alert Dialog" Style="{StaticResource SectionTitle}" />
                <ui:Button Text="Delete account" Variant="Destructive" Clicked="OnAlertDialogClicked" />
                <ui:AlertDialog x:Name="DeleteDialog"
                                Title="Are you absolutely sure?"
                                Description="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
                                ConfirmText="Delete account"
                                ConfirmVariant="Destructive" />

                <Label Text="Dialog, Drawer, Sheet" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:Dialog x:Name="DemoDialog" Margin="0,0,8,8">
                        <ui:DialogTrigger><ui:Button Text="Open dialog" Variant="Outline" /></ui:DialogTrigger>
                        <ui:DialogContent>
                            <ui:DialogHeader>
                                <ui:DialogTitle Text="Edit profile" />
                                <ui:DialogDescription Text="Make changes to your profile here. Click save when you are done." />
                            </ui:DialogHeader>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Name" Style="{StaticResource FieldLabel}" />
                                <ui:Input Text="Pedro Duarte" />
                            </VerticalStackLayout>
                            <ui:DialogFooter>
                                <ui:DialogClose><ui:Button Text="Cancel" Variant="Outline" /></ui:DialogClose>
                                <ui:Button Text="Save changes" Clicked="OnDialogSave" />
                            </ui:DialogFooter>
                        </ui:DialogContent>
                    </ui:Dialog>

                    <ui:Drawer x:Name="DemoDrawer" Margin="0,0,8,8">
                        <ui:DrawerTrigger><ui:Button Text="Open drawer" Variant="Outline" /></ui:DrawerTrigger>
                        <ui:DrawerContent>
                            <Label Text="Move goal" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource ShellUIForeground}" HorizontalOptions="Center" />
                            <Label Text="Set your daily activity goal." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                            <Label Text="350 kcal/day" FontSize="30" FontAttributes="Bold" TextColor="{DynamicResource ShellUIForeground}" HorizontalOptions="Center" />
                            <ui:Button Text="Submit" HorizontalOptions="Fill" Clicked="OnDrawerSubmit" />
                        </ui:DrawerContent>
                    </ui:Drawer>

                    <ui:Sheet x:Name="DemoSheet" Margin="0,0,8,8">
                        <ui:SheetTrigger><ui:Button Text="Open sheet" Variant="Outline" /></ui:SheetTrigger>
                        <ui:SheetContent>
                            <Label Text="Edit profile" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource ShellUIForeground}" />
                            <Label Text="Make changes to your profile here." Style="{StaticResource Muted}" />
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Name" Style="{StaticResource FieldLabel}" />
                                <ui:Input Text="Pedro Duarte" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Username" Style="{StaticResource FieldLabel}" />
                                <ui:Input Text="@peduarte" />
                            </VerticalStackLayout>
                            <ui:Button Text="Save changes" Clicked="OnSheetSave" />
                        </ui:SheetContent>
                    </ui:Sheet>
                </ui:WrapLayout>

                <!-- Tooltip / Hover card -->
                <Label Text="Tooltip &amp; Hover Card" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:Tooltip Text="Add to library" Margin="0,0,8,8">
                        <ui:Button Icon="Plus" Size="Icon" Variant="Outline" Clicked="OnButtonClicked" />
                    </ui:Tooltip>
                    <ui:Tooltip Text="Tooltips can sit below too" Placement="Bottom" Margin="0,0,8,8">
                        <ui:Button Text="Hover me" Variant="Outline" Clicked="OnButtonClicked" />
                    </ui:Tooltip>
                    <ui:HoverCard Margin="0,0,8,8">
                        <ui:HoverCardTrigger><ui:Button Text="@shellui" Variant="Link" /></ui:HoverCardTrigger>
                        <ui:HoverCardContent>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <ui:Avatar Fallback="SU" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="@shellui" Style="{StaticResource FieldLabel}" />
                                    <Label Text="Beautifully designed components for .NET: Blazor, MAUI and Avalonia." Style="{StaticResource Body}" />
                                    <Label Text="Joined December 2025" Style="{StaticResource Muted}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                        </ui:HoverCardContent>
                    </ui:HoverCard>
                </ui:WrapLayout>

                <Label Text="Dropdown &amp; Popover" Style="{StaticResource SectionTitle}" />
                <ui:WrapLayout>
                    <ui:Dropdown Margin="0,0,8,8">
                        <ui:DropdownTrigger>
                            <ui:Button Text="Open menu" Variant="Outline" Icon="ChevronDown" IconPosition="Right" />
                        </ui:DropdownTrigger>
                        <ui:DropdownContent>
                            <ui:DropdownItem Text="Profile" Icon="User" Clicked="OnDropdownItem" />
                            <ui:DropdownItem Text="Settings" Icon="Settings" Clicked="OnDropdownItem" />
                            <ui:DropdownItem Text="Notifications" Icon="Bell" Clicked="OnDropdownItem" />
                        </ui:DropdownContent>
                    </ui:Dropdown>
                    <ui:Popover Margin="0,0,8,8">
                        <ui:PopoverTrigger>
                            <ui:Button Text="Open popover" Variant="Outline" />
                        </ui:PopoverTrigger>
                        <ui:PopoverContent>
                            <Label Text="Dimensions" Style="{StaticResource FieldLabel}" />
                            <Label Text="Set the dimensions for the layer." Style="{StaticResource Muted}" />
                            <ui:Input Placeholder="Width" />
                        </ui:PopoverContent>
                    </ui:Popover>
                </ui:WrapLayout>

                <!-- Context menu -->
                <Label Text="Context Menu" Style="{StaticResource SectionTitle}" />
                <ui:ContextMenu>
                    <ui:ContextMenuTrigger>
                        <Border StrokeThickness="1" Stroke="{DynamicResource ShellUIBorderBrush}" StrokeDashArray="4,4"
                                StrokeShape="RoundRectangle 6" HeightRequest="120" BackgroundColor="Transparent">
                            <Label Text="Right-click here (long-press on touch)" Style="{StaticResource Muted}" FontSize="14"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </ui:ContextMenuTrigger>
                    <ui:ContextMenuContent>
                        <ui:ContextMenuItem Text="Back" Icon="ArrowLeft" Shortcut="Alt+Left" Clicked="OnContextMenuItem" />
                        <ui:ContextMenuItem Text="Reload" Icon="RefreshCw" Shortcut="Ctrl+R" Clicked="OnContextMenuItem" />
                        <ui:ContextMenuItem Text="Copy link" Icon="Link" Clicked="OnContextMenuItem" />
                        <ui:ContextMenuItem Text="Save as..." Icon="Save" IsEnabled="False" />
                        <ui:ContextMenuSeparator />
                        <ui:ContextMenuItem Text="Delete" Icon="Trash2" IsDestructive="True" Clicked="OnContextMenuItem" />
                    </ui:ContextMenuContent>
                </ui:ContextMenu>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GroupNavigation" Spacing="16" IsVisible="False">
                <!-- Collapsible -->
                <Label Text="Collapsible" Style="{StaticResource SectionTitle}" />
                <ui:Collapsible>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="@peduarte starred 3 repositories" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                        <ui:CollapsibleTrigger Grid.Column="1">
                            <ui:Button Icon="ChevronsUpDown" Size="Icon" Variant="Ghost" />
                        </ui:CollapsibleTrigger>
                    </Grid>
                    <ui:Card><Label Text="@radix-ui/primitives" Style="{StaticResource Body}" Margin="16,12" /></ui:Card>
                    <ui:CollapsibleContent>
                        <VerticalStackLayout Spacing="8">
                            <ui:Card><Label Text="@radix-ui/colors" Style="{StaticResource Body}" Margin="16,12" /></ui:Card>
                            <ui:Card><Label Text="@stitches/react" Style="{StaticResource Body}" Margin="16,12" /></ui:Card>
                        </VerticalStackLayout>
                    </ui:CollapsibleContent>
                </ui:Collapsible>

                <!-- Accordion -->
                <Label Text="Accordion" Style="{StaticResource SectionTitle}" />
                <ui:Accordion Type="Single" Value="item-1">
                    <ui:AccordionItem Value="item-1">
                        <ui:AccordionTrigger Text="Is it accessible?" />
                        <ui:AccordionContent>
                            <Label Text="Yes. It adheres to the WAI-ARIA design pattern." Style="{StaticResource Body}" />
                        </ui:AccordionContent>
                    </ui:AccordionItem>
                    <ui:AccordionItem Value="item-2">
                        <ui:AccordionTrigger Text="Is it styled?" />
                        <ui:AccordionContent>
                            <Label Text="Yes. It comes with default styles that match the other components." Style="{StaticResource Body}" />
                        </ui:AccordionContent>
                    </ui:AccordionItem>
                    <ui:AccordionItem Value="item-3">
                        <ui:AccordionTrigger Text="Is it animated?" />
                        <ui:AccordionContent>
                            <Label Text="Yes. It expands and collapses smoothly." Style="{StaticResource Body}" />
                        </ui:AccordionContent>
                    </ui:AccordionItem>
                </ui:Accordion>

                <!-- Tabs -->
                <Label Text="Tabs" Style="{StaticResource SectionTitle}" />
                <ui:Tabs Value="account" ValueChanged="OnTabChanged">
                    <ui:TabsList>
                        <ui:TabsTrigger Value="account" Text="Account" />
                        <ui:TabsTrigger Value="password" Text="Password" />
                        <ui:TabsTrigger Value="activity" Text="Activity" />
                    </ui:TabsList>
                    <ui:TabsContent Value="account">
                        <ui:Card>
                            <ui:CardHeader Title="Account" Description="Make changes to your account here." />
                            <ui:CardContent><ui:Input Text="Pedro Duarte" /></ui:CardContent>
                        </ui:Card>
                    </ui:TabsContent>
                    <ui:TabsContent Value="password">
                        <ui:Card>
                            <ui:CardHeader Title="Password" Description="Change your password here." />
                            <ui:CardContent><ui:Input Placeholder="New password" IsPassword="True" /></ui:CardContent>
                        </ui:Card>
                    </ui:TabsContent>
                    <ui:TabsContent Value="activity">
                        <Label Text="No recent activity." Style="{StaticResource Muted}" />
                    </ui:TabsContent>
                </ui:Tabs>

                <!-- Stepper -->
                <Label Text="Stepper" Style="{StaticResource SectionTitle}" />
                <ui:Stepper x:Name="StepperDemo" CurrentStepChanged="OnStepChanged" Confirmed="OnStepperConfirmed">
                    <ui:StepperStep Title="Account" Description="Your details">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Email" Style="{StaticResource FieldLabel}" />
                            <ui:Input Placeholder="you@example.com" Keyboard="Email" />
                        </VerticalStackLayout>
                    </ui:StepperStep>
                    <ui:StepperStep Title="Plan" Description="Pick a tier">
                        <ui:RadioGroup Value="pro">
                            <ui:RadioGroupItem Value="free" Text="Free" />
                            <ui:RadioGroupItem Value="pro" Text="Pro" />
                            <ui:RadioGroupItem Value="team" Text="Team" />
                        </ui:RadioGroup>
                    </ui:StepperStep>
                    <ui:StepperStep Title="Review" Description="Confirm and finish">
                        <Label Text="Everything looks good. Press Confirm to create the workspace." FontSize="14"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </ui:StepperStep>
                </ui:Stepper>

                <!-- Breadcrumb -->
                <Label Text="Breadcrumb" Style="{StaticResource SectionTitle}" />
                <ui:Breadcrumb>
                    <ui:BreadcrumbItem Text="Home" Clicked="OnBreadcrumbClicked" />
                    <ui:BreadcrumbItem Text="Components" Clicked="OnBreadcrumbClicked" />
                    <ui:BreadcrumbItem Text="Breadcrumb" IsCurrent="True" />
                </ui:Breadcrumb>

                <!-- Pagination -->
                <Label Text="Pagination" Style="{StaticResource SectionTitle}" />
                <ui:Pagination x:Name="PaginationDemo" Page="5" TotalPages="20" PageChanged="OnPageChanged" />

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GroupData" Spacing="16" IsVisible="False">
                <!-- Carousel -->
                <Label Text="Carousel" Style="{StaticResource SectionTitle}" />
                <ui:Carousel x:Name="CarouselDemo" AspectRatio="2.4" WidthRequest="{OnIdiom Phone=-1, Default=560}"
                             HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}"
                             PositionChanged="OnCarouselChanged">
                    <Grid BackgroundColor="{DynamicResource ShellUIMuted}">
                        <Label Text="1" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </Grid>
                    <Grid BackgroundColor="{DynamicResource ShellUISecondary}">
                        <Label Text="2" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </Grid>
                    <Grid BackgroundColor="{DynamicResource ShellUIAccent}">
                        <Label Text="3" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </Grid>
                    <Grid BackgroundColor="{DynamicResource ShellUIMuted}">
                        <Label Text="4" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource ShellUIForeground}" />
                    </Grid>
                </ui:Carousel>

                <!-- Skeleton -->
                <Label Text="Skeleton" Style="{StaticResource SectionTitle}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <ui:Skeleton WidthRequest="48" HeightRequest="48" CornerRadius="24" />
                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <ui:Skeleton HeightRequest="16" WidthRequest="250" HorizontalOptions="Start" />
                        <ui:Skeleton HeightRequest="16" WidthRequest="200" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Table -->
                <Label Text="Table" Style="{StaticResource SectionTitle}" />
                <ui:Table Columns="*,*,1.4*,90" MinimumContentWidth="440" Caption="A list of your recent invoices.">
                    <ui:TableHeader>
                        <ui:TableHead Text="Invoice" />
                        <ui:TableHead Text="Status" />
                        <ui:TableHead Text="Method" />
                        <ui:TableHead Text="Amount" HorizontalTextAlignment="End" />
                    </ui:TableHeader>
                    <ui:TableRow Tapped="OnTableRowTapped">
                        <ui:TableCell Text="INV001" IsBold="True" />
                        <ui:TableCell><ui:Badge Text="Paid" Variant="Success" HorizontalOptions="Start" VerticalOptions="Center" /></ui:TableCell>
                        <ui:TableCell Text="Credit Card" />
                        <ui:TableCell Text="$250.00" HorizontalTextAlignment="End" />
                    </ui:TableRow>
                    <ui:TableRow Tapped="OnTableRowTapped">
                        <ui:TableCell Text="INV002" IsBold="True" />
                        <ui:TableCell><ui:Badge Text="Pending" Variant="Warning" HorizontalOptions="Start" VerticalOptions="Center" /></ui:TableCell>
                        <ui:TableCell Text="PayPal" />
                        <ui:TableCell Text="$150.00" HorizontalTextAlignment="End" />
                    </ui:TableRow>
                    <ui:TableRow Tapped="OnTableRowTapped">
                        <ui:TableCell Text="INV003" IsBold="True" />
                        <ui:TableCell><ui:Badge Text="Unpaid" Variant="Destructive" HorizontalOptions="Start" VerticalOptions="Center" /></ui:TableCell>
                        <ui:TableCell Text="Bank Transfer" />
                        <ui:TableCell Text="$350.00" HorizontalTextAlignment="End" />
                    </ui:TableRow>
                    <ui:TableRow Tapped="OnTableRowTapped">
                        <ui:TableCell Text="INV004" IsBold="True" />
                        <ui:TableCell><ui:Badge Text="Paid" Variant="Success" HorizontalOptions="Start" VerticalOptions="Center" /></ui:TableCell>
                        <ui:TableCell Text="Credit Card" />
                        <ui:TableCell Text="$450.00" HorizontalTextAlignment="End" />
                    </ui:TableRow>
                </ui:Table>

                <!-- Empty state -->
                <Label Text="Empty State" Style="{StaticResource SectionTitle}" />
                <ui:EmptyState Icon="Folder" Title="No projects yet" Bordered="True"
                               Description="You haven't created any projects. Get started by creating your first one.">
                    <ui:Button Text="Create project" Icon="Plus" Clicked="OnButtonClicked" />
                    <ui:Button Text="Import" Variant="Outline" Clicked="OnButtonClicked" />
                </ui:EmptyState>

                <!-- Timeline -->
                <Label Text="Timeline" Style="{StaticResource SectionTitle}" />
                <ui:Timeline>
                    <ui:TimelineItem Title="Order placed" Time="09:12" Text="We received your order and sent a confirmation." />
                    <ui:TimelineItem Title="Payment confirmed" Time="09:14" Icon="CreditCard" Text="Charged to the card ending in 4242." />
                    <ui:TimelineItem Title="Shipped" Time="14:40" Icon="Send" IsActive="True">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Your parcel is on its way." FontSize="14" TextColor="{DynamicResource ShellUIMutedForeground}" />
                            <ui:Badge Text="In transit" Variant="Info" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </ui:TimelineItem>
                    <ui:TimelineItem Title="Delivered" Text="Expected tomorrow." />
                </ui:Timeline>

                <!-- Scroll area -->
                <Label Text="Scroll Area" Style="{StaticResource SectionTitle}" />
                <Border StrokeThickness="1" Stroke="{DynamicResource ShellUIBorderBrush}"
                        StrokeShape="RoundRectangle 6" WidthRequest="240" HorizontalOptions="Start">
                    <ui:ScrollArea HeightRequest="180">
                        <VerticalStackLayout x:Name="TagList" Padding="16" Spacing="8">
                            <Label Text="Tags" Style="{StaticResource FieldLabel}" />
                        </VerticalStackLayout>
                    </ui:ScrollArea>
                </Border>

                </VerticalStackLayout>

                <ui:Separator Margin="0,24,0,0" />
                <Label Text="Built with ShellUI Native." Style="{StaticResource Muted}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
