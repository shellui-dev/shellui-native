<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AvaloniaDemo.Components.UI"
        x:Class="AvaloniaDemo.MainWindow"
        Title="ShellUI Native (Avalonia)"
        Icon="/Assets/icon.ico"
        Width="1000" Height="760"
        Background="{DynamicResource ShellUIBackgroundBrush}">

    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ShellUIForegroundBrush}" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource ShellUIMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Styles>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="ShellUI Native" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource ShellUIForegroundBrush}" />
                    <TextBlock Classes="hint" Text="Avalonia components with the same design tokens as ShellUI." />
                </StackPanel>
                <ui:ThemeToggle Grid.Column="1" />
            </Grid>

            <TextBlock Classes="title" Text="Buttons" />
            <TextBlock Classes="hint" Text="Variants, sizes, icons, loading and disabled." />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <ui:Button Text="Default" />
                <ui:Button Text="Secondary" Variant="Secondary" />
                <ui:Button Text="Outline" Variant="Outline" />
                <ui:Button Text="Ghost" Variant="Ghost" />
                <ui:Button Text="Destructive" Variant="Destructive" />
                <ui:Button Text="Link" Variant="Link" />
            </WrapPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,8,0,0">
                <ui:Button Text="Small" Size="Sm" />
                <ui:Button Text="Large" Size="Lg" />
                <ui:Button Icon="Settings" Size="Icon" Variant="Outline" />
                <ui:Button Text="New item" Icon="Plus" />
                <ui:Button Text="Continue" Icon="ArrowRight" IconPosition="Right" Variant="Outline" />
                <ui:Button x:Name="LoadingButton" Text="Save" />
                <ui:Button Text="Disabled" IsEnabled="False" />
            </WrapPanel>
            <TextBlock x:Name="ClickCount" Classes="hint" Margin="0,8,0,0" Text="Click Save to see the loading state." />

            <TextBlock Classes="title" Text="Form controls" />
            <TextBlock Classes="hint" Text="Input, checkbox, switch and label at the 40px form baseline." />
            <StackPanel Spacing="12" Width="360" HorizontalAlignment="Left">
                <ui:ShellLabel Text="Email" Size="Sm" Weight="Medium" />
                <ui:Input Placeholder="you@example.com" />
                <ui:Input Placeholder="Password" IsPassword="True" />
                <ui:Input Text="Invalid value" HasError="True" />
                <ui:Checkbox Label="Accept terms and conditions" />
                <ui:Checkbox Label="Required" HasError="True" />
                <ui:Switch Label="Airplane mode" />
                <ui:Switch Label="Notifications" IsToggled="True" />
                <ui:Textarea Placeholder="Type your message here." />
                <ui:Select x:Name="CountrySelect" Placeholder="Select a country" />
                <ui:Slider x:Name="VolumeSlider" Value="40" />
                <TextBlock x:Name="VolumeText" Classes="hint" Text="Volume 40" />
                <ui:RadioGroup Value="comfortable">
                    <ui:RadioGroupItem Value="default" Text="Default" />
                    <ui:RadioGroupItem Value="comfortable" Text="Comfortable" />
                    <ui:RadioGroupItem Value="compact" Text="Compact" />
                </ui:RadioGroup>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:DatePicker x:Name="DueDate" />
                    <ui:TimePicker x:Name="StartTime" MinuteStep="15" />
                </StackPanel>
                <ui:DateRangePicker x:Name="DemoDateRange" />
                <ui:FileUpload x:Name="DemoFileUpload" Multiple="True" MaxFiles="5" />
                <TextBlock x:Name="PickerChoice" Classes="hint" Text="Pick a date range or some files." />
            </StackPanel>
            <ui:Card HorizontalAlignment="Left" Margin="0,12,0,0">
                <ui:CardContent Padding="12">
                    <ui:Calendar />
                </ui:CardContent>
            </ui:Card>

            <TextBlock Classes="title" Text="Card" />
            <TextBlock Classes="hint" Text="Header, content and footer parts." />
            <WrapPanel ItemSpacing="16" LineSpacing="16">
                <ui:Card Width="380">
                    <ui:CardHeader Title="Create project" Description="Deploy your new project in one click." />
                    <ui:CardContent>
                        <ui:Input Placeholder="Name of your project" />
                    </ui:CardContent>
                    <ui:CardFooter>
                        <ui:Button Text="Cancel" Variant="Outline" />
                        <ui:Button Text="Deploy" />
                    </ui:CardFooter>
                </ui:Card>
                <ui:Card Width="300" Variant="Elevated">
                    <ui:CardHeader Title="Elevated" Description="A larger shadow for cards that float." />
                    <ui:CardContent>
                        <ui:ShellLabel Text="Body text in the card." Size="Sm" Variant="Muted" />
                    </ui:CardContent>
                </ui:Card>
            </WrapPanel>

            <TextBlock Classes="title" Text="Badges, separators and progress" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <ui:Badge Text="Default" />
                <ui:Badge Text="Secondary" Variant="Secondary" />
                <ui:Badge Text="Outline" Variant="Outline" />
                <ui:Badge Text="Destructive" Variant="Destructive" />
                <ui:Badge Text="Success" Variant="Success" />
                <ui:Badge Text="Warning" Variant="Warning" />
                <ui:Badge Text="Info" Variant="Info" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Height="20" Spacing="12" Margin="0,12,0,0">
                <ui:ShellLabel Text="Blog" Size="Sm" />
                <ui:Separator Orientation="Vertical" />
                <ui:ShellLabel Text="Docs" Size="Sm" />
                <ui:Separator Orientation="Vertical" />
                <ui:ShellLabel Text="Source" Size="Sm" />
            </StackPanel>
            <ui:Separator Margin="0,12" />
            <StackPanel Spacing="12" Width="360" HorizontalAlignment="Left">
                <ui:Progress x:Name="Progress" Value="40" ShowLabel="True" />
                <ui:Progress Value="75" Variant="Success" />
                <ui:Progress Value="25" Variant="Destructive" />
            </StackPanel>

            <TextBlock Classes="title" Text="Alerts" />
            <StackPanel Spacing="12" Width="520" HorizontalAlignment="Left">
                <ui:Alert Title="Heads up!" Message="You can add components to your app using the CLI." />
                <ui:Alert Title="Error" Message="Your session has expired. Please log in again." Variant="Destructive" />
                <ui:Alert Title="Saved" Message="Your changes have been saved." Variant="Success" />
                <ui:Alert Title="Careful" Message="This action can't be undone." Variant="Warning" />
                <ui:Alert Title="Tip" Message="Press Tab to see the focus ring." Variant="Info" />
            </StackPanel>

            <TextBlock Classes="title" Text="Overlays" />
            <TextBlock Classes="hint" Text="Dialog, drawer, sheet, dropdown and popover. Escape closes the one on top." />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <ui:Dialog x:Name="DemoDialog">
                    <ui:DialogTrigger><ui:Button x:Name="OpenDialog" Text="Open dialog" Variant="Outline" /></ui:DialogTrigger>
                    <ui:DialogContent>
                        <ui:DialogHeader>
                            <ui:DialogTitle Text="Edit profile" />
                            <ui:DialogDescription Text="Make changes to your profile here. Click save when you're done." />
                        </ui:DialogHeader>
                        <ui:ShellLabel Text="Name" Size="Sm" Weight="Medium" />
                        <ui:Input Text="Shewart Shepherd" />
                        <ui:DialogFooter>
                            <ui:DialogClose><ui:Button Text="Cancel" Variant="Outline" /></ui:DialogClose>
                            <ui:DialogClose><ui:Button Text="Save changes" /></ui:DialogClose>
                        </ui:DialogFooter>
                    </ui:DialogContent>
                </ui:Dialog>

                <ui:Drawer x:Name="DemoDrawer">
                    <ui:DrawerTrigger><ui:Button x:Name="OpenDrawer" Text="Open drawer" Variant="Outline" /></ui:DrawerTrigger>
                    <ui:DrawerContent>
                        <ui:DialogTitle Text="Move goal" />
                        <ui:DialogDescription Text="Set your daily activity goal." />
                        <ui:Progress Value="60" ShowLabel="True" />
                    </ui:DrawerContent>
                </ui:Drawer>

                <ui:Sheet x:Name="DemoSheet">
                    <ui:SheetTrigger><ui:Button x:Name="OpenSheet" Text="Open sheet" Variant="Outline" /></ui:SheetTrigger>
                    <ui:SheetContent>
                        <ui:DialogTitle Text="Settings" />
                        <ui:DialogDescription Text="Adjust your preferences." />
                        <ui:Switch Label="Notifications" IsToggled="True" />
                        <ui:Switch Label="Airplane mode" />
                    </ui:SheetContent>
                </ui:Sheet>

                <ui:Dropdown x:Name="DemoDropdown">
                    <ui:DropdownTrigger><ui:Button x:Name="OpenDropdown" Text="Options" Icon="ChevronDown" IconPosition="Right" Variant="Outline" /></ui:DropdownTrigger>
                    <ui:DropdownContent>
                        <ui:DropdownItem Text="Profile" Icon="User" />
                        <ui:DropdownItem Text="Settings" Icon="Settings" />
                        <ui:DropdownItem Text="Log out" Icon="LogOut" />
                    </ui:DropdownContent>
                </ui:Dropdown>

                <ui:Popover x:Name="DemoPopover">
                    <ui:PopoverTrigger><ui:Button x:Name="OpenPopover" Text="Open popover" Variant="Outline" /></ui:PopoverTrigger>
                    <ui:PopoverContent>
                        <ui:ShellLabel Text="Dimensions" Weight="Semibold" Size="Sm" />
                        <ui:ShellLabel Text="Set the dimensions for the layer." Size="Sm" Variant="Muted" />
                        <ui:Input Text="100%" />
                    </ui:PopoverContent>
                </ui:Popover>
            </WrapPanel>
            <TextBlock x:Name="MenuChoice" Classes="hint" Margin="0,8,0,0" Text="Pick a menu item." />

            <TextBlock Classes="title" Text="Navigation and layout" />
            <TextBlock Classes="hint" Text="Tabs, accordion, collapsible, breadcrumb, scroll area and skeleton." />
            <ui:Breadcrumb x:Name="DemoBreadcrumb" Margin="0,0,0,12">
                <ui:BreadcrumbItem Text="Home" />
                <ui:BreadcrumbItem Text="Components" />
                <ui:BreadcrumbItem Text="Breadcrumb" IsCurrent="True" />
            </ui:Breadcrumb>
            <ui:Tabs x:Name="DemoTabs" Value="account" Width="400" HorizontalAlignment="Left">
                <ui:TabsList>
                    <ui:TabsTrigger Value="account" Text="Account" />
                    <ui:TabsTrigger Value="password" Text="Password" />
                    <ui:TabsTrigger Value="billing" Text="Billing" IsEnabled="False" />
                </ui:TabsList>
                <ui:TabsContent Value="account">
                    <ui:Card>
                        <ui:CardHeader Title="Account" Description="Make changes to your account here." />
                        <ui:CardContent><ui:Input Text="Shewart Shepherd" /></ui:CardContent>
                    </ui:Card>
                </ui:TabsContent>
                <ui:TabsContent Value="password">
                    <ui:Card>
                        <ui:CardHeader Title="Password" Description="Change your password here." />
                        <ui:CardContent><ui:Input Placeholder="New password" IsPassword="True" /></ui:CardContent>
                    </ui:Card>
                </ui:TabsContent>
            </ui:Tabs>
            <ui:Accordion x:Name="DemoAccordion" Value="a" Width="480" HorizontalAlignment="Left" Margin="0,12,0,0">
                <ui:AccordionItem Value="a">
                    <ui:AccordionTrigger Text="Is it accessible?" />
                    <ui:AccordionContent><ui:ShellLabel Text="Yes. Every trigger is a tab stop and opens with Enter or Space." Size="Sm" /></ui:AccordionContent>
                </ui:AccordionItem>
                <ui:AccordionItem Value="b">
                    <ui:AccordionTrigger Text="Is it styled?" />
                    <ui:AccordionContent><ui:ShellLabel Text="Yes. It uses the same tokens as the other components." Size="Sm" /></ui:AccordionContent>
                </ui:AccordionItem>
                <ui:AccordionItem Value="c">
                    <ui:AccordionTrigger Text="Is it animated?" />
                    <ui:AccordionContent><ui:ShellLabel Text="Yes. Content grows to its height and the chevron turns." Size="Sm" /></ui:AccordionContent>
                </ui:AccordionItem>
            </ui:Accordion>
            <ui:Collapsible x:Name="DemoCollapsible" Width="360" HorizontalAlignment="Left" Margin="0,12,0,0">
                <ui:CollapsibleTrigger><ui:Button x:Name="ToggleCollapsible" Text="Show starred repositories" Icon="ChevronsUpDown" IconPosition="Right" Variant="Outline" /></ui:CollapsibleTrigger>
                <ui:CollapsibleContent>
                    <StackPanel Spacing="8">
                        <ui:ShellLabel Text="shellui-dev/shellui" Size="Sm" />
                        <ui:ShellLabel Text="shellui-dev/shellui-native" Size="Sm" />
                        <ui:ShellLabel Text="shellui-dev/shell-icons" Size="Sm" />
                    </StackPanel>
                </ui:CollapsibleContent>
            </ui:Collapsible>
            <WrapPanel ItemSpacing="16" LineSpacing="16" Margin="0,12,0,0">
                <Border Width="200" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ShellUIBorderBrush}">
                    <ui:ScrollArea x:Name="DemoScrollArea" Height="160">
                        <StackPanel x:Name="Tags" Margin="16,12" Spacing="8" />
                    </ui:ScrollArea>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Top">
                    <ui:Skeleton Width="48" Height="48" CornerRadius="24" />
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <ui:Skeleton Width="250" Height="16" />
                        <ui:Skeleton Width="200" Height="16" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
            <TextBlock x:Name="NavChoice" Classes="hint" Margin="0,8,0,0" Text="Click a breadcrumb or open a section." />

            <TextBlock Classes="title" Text="Feedback" />
            <TextBlock Classes="hint" Text="Spinner, toast, alert dialog, tooltip and hover card." />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ui:Spinner Size="Sm" />
                <ui:Spinner />
                <ui:Spinner Size="Lg" Token="MutedForeground" />
            </StackPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,12,0,0">
                <ui:Button x:Name="ToastDefault" Text="Show toast" Variant="Outline" />
                <ui:Button x:Name="ToastSuccess" Text="Success" Variant="Outline" />
                <ui:Button x:Name="ToastError" Text="Error" Variant="Outline" />
                <ui:Button x:Name="ToastWarning" Text="Warning" Variant="Outline" />
                <ui:Button x:Name="ToastInfo" Text="Info" Variant="Outline" />
                <ui:Button x:Name="ToastAction" Text="With action" Variant="Outline" />
            </WrapPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,12,0,0">
                <ui:Button x:Name="DeleteAccount" Text="Delete account" Variant="Destructive" />
                <ui:AlertDialog x:Name="DeleteDialog" Title="Are you absolutely sure?"
                                Description="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
                                ConfirmText="Delete account" ConfirmVariant="Destructive" />
                <ui:Tooltip Text="Add to library">
                    <ui:Button Icon="Plus" Size="Icon" Variant="Outline" />
                </ui:Tooltip>
                <ui:Tooltip Text="Tooltips can sit below too" Placement="Bottom">
                    <ui:Button Text="Hover me" Variant="Outline" />
                </ui:Tooltip>
                <ui:HoverCard x:Name="DemoHoverCard">
                    <ui:HoverCardTrigger><ui:Button Text="@shellui" Variant="Link" /></ui:HoverCardTrigger>
                    <ui:HoverCardContent>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ui:Avatar Source="/Assets/Brand/shellui.png" Fallback="SU" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <ui:ShellLabel Text="@shellui" Weight="Semibold" Size="Sm" />
                                <ui:ShellLabel Text="Copy-and-own components for Blazor and native .NET apps." Size="Sm" />
                                <ui:ShellLabel Text="Joined December 2024" Size="Xs" Variant="Muted" />
                            </StackPanel>
                        </Grid>
                    </ui:HoverCardContent>
                </ui:HoverCard>
            </WrapPanel>
            <TextBlock x:Name="FeedbackChoice" Classes="hint" Margin="0,8,0,0" Text="Open the alert dialog or show a toast." />

            <TextBlock Classes="title" Text="Data display" />
            <TextBlock Classes="hint" Text="Avatar, toggle, callout, table, empty state and pagination." />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ui:Avatar Source="/Assets/Brand/shellui.png" Fallback="SU" />
                <ui:Avatar Fallback="SS" />
                <ui:Avatar />
                <ui:Avatar Source="/Assets/Brand/shellicons.png" Fallback="SI" Size="Sm" />
                <ui:Avatar Fallback="SS" Size="Lg" />
                <ui:Avatar Source="/Assets/Brand/shellui_native.png" Fallback="SN" Size="Xl" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <ui:Toggle Icon="Star" />
                <ui:Toggle Icon="Star" Text="Favorite" IsPressed="True" />
                <ui:Toggle Text="Outline" Variant="Outline" />
                <ui:Toggle Text="Small" Size="Sm" Variant="Outline" />
                <ui:Toggle Text="Disabled" IsEnabled="False" />
            </StackPanel>
            <StackPanel Spacing="12" Width="560" HorizontalAlignment="Left" Margin="0,12,0,0">
                <ui:Callout Title="Note" Text="Components are copied into your project, so you own and can change the code." />
                <ui:Callout Variant="Tip" Title="Pro tip" Text="Run shellui-native list to see every component for your platform." />
                <ui:Callout Variant="Warning" Title="Heads up" Text="Avalonia templates aren't on NuGet yet." />
                <ui:Callout Variant="Danger" Title="Breaking change" Text="Icon uses Kind instead of Name on Avalonia." />
                <ui:Callout Variant="Default" Text="A neutral callout without a title." />
            </StackPanel>
            <ui:Table x:Name="DemoTable" Columns="*,*,1.4*,90" MinimumContentWidth="440" Width="560" HorizontalAlignment="Left"
                      Caption="A list of your recent invoices." Margin="0,12,0,0">
                <ui:TableHeader>
                    <ui:TableHead Text="Invoice" />
                    <ui:TableHead Text="Status" />
                    <ui:TableHead Text="Method" />
                    <ui:TableHead Text="Amount" HorizontalTextAlignment="End" />
                </ui:TableHeader>
                <ui:TableRow>
                    <ui:TableCell Text="INV001" IsBold="True" />
                    <ui:TableCell><ui:Badge Text="Paid" Variant="Success" HorizontalAlignment="Left" VerticalAlignment="Center" /></ui:TableCell>
                    <ui:TableCell Text="Credit Card" />
                    <ui:TableCell Text="$250.00" HorizontalTextAlignment="End" />
                </ui:TableRow>
                <ui:TableRow>
                    <ui:TableCell Text="INV002" IsBold="True" />
                    <ui:TableCell><ui:Badge Text="Pending" Variant="Warning" HorizontalAlignment="Left" VerticalAlignment="Center" /></ui:TableCell>
                    <ui:TableCell Text="PayPal" />
                    <ui:TableCell Text="$150.00" HorizontalTextAlignment="End" />
                </ui:TableRow>
                <ui:TableRow>
                    <ui:TableCell Text="INV003" IsBold="True" />
                    <ui:TableCell><ui:Badge Text="Unpaid" Variant="Destructive" HorizontalAlignment="Left" VerticalAlignment="Center" /></ui:TableCell>
                    <ui:TableCell Text="Bank Transfer" />
                    <ui:TableCell Text="$350.00" HorizontalTextAlignment="End" />
                </ui:TableRow>
                <ui:TableRow>
                    <ui:TableCell Text="INV004" IsBold="True" />
                    <ui:TableCell><ui:Badge Text="Paid" Variant="Success" HorizontalAlignment="Left" VerticalAlignment="Center" /></ui:TableCell>
                    <ui:TableCell Text="Credit Card" />
                    <ui:TableCell Text="$450.00" HorizontalTextAlignment="End" />
                </ui:TableRow>
            </ui:Table>
            <ui:EmptyState Icon="Folder" Title="No projects yet" Bordered="True" Width="560" HorizontalAlignment="Left" Margin="0,12,0,0"
                           Description="You haven't created any projects. Get started by creating your first one.">
                <ui:Button Text="Create project" Icon="Plus" />
                <ui:Button Text="Import" Variant="Outline" />
            </ui:EmptyState>
            <ui:Pagination x:Name="DemoPagination" TotalPages="20" Page="5" Margin="0,12,0,0" />
            <TextBlock x:Name="DataChoice" Classes="hint" Margin="0,8,0,0" Text="Click a row or a page." />

            <TextBlock Classes="title" Text="Menus, slides and steps" />
            <TextBlock Classes="hint" Text="Context menu, carousel and stepper." />
            <ui:ContextMenu x:Name="DemoContextMenu" Width="560" HorizontalAlignment="Left">
                <ui:ContextMenuTrigger>
                    <Panel Height="120">
                        <Rectangle Stroke="{DynamicResource ShellUIBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4"
                                   RadiusX="6" RadiusY="6" />
                        <ui:ShellLabel Text="Right-click here (long-press on touch)" Size="Sm" Variant="Muted"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </ui:ContextMenuTrigger>
                <ui:ContextMenuContent>
                    <ui:ContextMenuItem Text="Back" Icon="ArrowLeft" Shortcut="Alt+Left" />
                    <ui:ContextMenuItem Text="Reload" Icon="RefreshCw" Shortcut="Ctrl+R" />
                    <ui:ContextMenuItem Text="Copy link" Icon="Link" />
                    <ui:ContextMenuItem Text="Save as..." Icon="Save" IsEnabled="False" />
                    <ui:ContextMenuSeparator />
                    <ui:ContextMenuItem Text="Delete" Icon="Trash2" IsDestructive="True" />
                </ui:ContextMenuContent>
            </ui:ContextMenu>
            <ui:Carousel x:Name="DemoCarousel" AspectRatio="2.4" Width="560" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Panel Background="{DynamicResource ShellUIMutedBrush}">
                    <TextBlock Text="1" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ShellUIForegroundBrush}" />
                </Panel>
                <Panel Background="{DynamicResource ShellUISecondaryBrush}">
                    <TextBlock Text="2" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ShellUIForegroundBrush}" />
                </Panel>
                <Panel Background="{DynamicResource ShellUIAccentBrush}">
                    <TextBlock Text="3" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ShellUIForegroundBrush}" />
                </Panel>
                <Panel Background="{DynamicResource ShellUIMutedBrush}">
                    <TextBlock Text="4" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ShellUIForegroundBrush}" />
                </Panel>
            </ui:Carousel>
            <ui:Stepper x:Name="DemoStepper" Width="560" HorizontalAlignment="Left" Margin="0,24,0,0">
                <ui:StepperStep Title="Account" Description="Your details">
                    <StackPanel Spacing="8">
                        <ui:ShellLabel Text="Email" Size="Sm" Weight="Medium" />
                        <ui:Input Placeholder="you@example.com" />
                    </StackPanel>
                </ui:StepperStep>
                <ui:StepperStep Title="Plan" Description="Pick a tier">
                    <ui:RadioGroup Value="pro">
                        <ui:RadioGroupItem Value="free" Text="Free" />
                        <ui:RadioGroupItem Value="pro" Text="Pro" />
                        <ui:RadioGroupItem Value="team" Text="Team" />
                    </ui:RadioGroup>
                </ui:StepperStep>
                <ui:StepperStep Title="Review" Description="Confirm and finish">
                    <ui:ShellLabel Text="Everything looks good. Press Confirm to create the workspace." Size="Sm" />
                </ui:StepperStep>
            </ui:Stepper>
            <TextBlock x:Name="AdvancedChoice" Classes="hint" Margin="0,8,0,0" Text="Right-click the box, move the carousel or walk through the steps." />

            <TextBlock Classes="title" Text="More form controls" />
            <TextBlock Classes="hint" Text="Toggle group, input OTP, number input, tag input, combobox and multi-select." />
            <StackPanel Spacing="12" Width="360" HorizontalAlignment="Left">
                <ui:ToggleGroup x:Name="ViewToggleGroup" Value="week">
                    <ui:ToggleGroupItem Value="day" Text="Day" />
                    <ui:ToggleGroupItem Value="week" Text="Week" />
                    <ui:ToggleGroupItem Value="month" Text="Month" />
                </ui:ToggleGroup>
                <ui:ToggleGroup x:Name="MarksToggleGroup" Multiple="True" Variant="Outline">
                    <ui:ToggleGroupItem Value="star" Icon="Star" />
                    <ui:ToggleGroupItem Value="heart" Icon="Heart" />
                    <ui:ToggleGroupItem Value="bookmark" Icon="Bookmark" />
                </ui:ToggleGroup>
                <ui:InputOtp x:Name="DemoOtp" Length="6" />
                <ui:NumberInput x:Name="QuantityInput" Value="2" Minimum="0" Maximum="10" Width="160" HorizontalAlignment="Left" />
                <ui:TagInput x:Name="DemoTags" Placeholder="Add a label and press Enter..." MaxTags="6" />
                <ui:Combobox x:Name="FrameworkCombobox" Placeholder="Select framework..." SearchPlaceholder="Search framework..." />
                <ui:MultiSelect x:Name="FrameworkMultiSelect" Placeholder="Select frameworks..." SearchPlaceholder="Search framework..." />
            </StackPanel>
            <TextBlock x:Name="FormChoice" Classes="hint" Margin="0,8,0,0" Text="Change a control to see its value here." />

            <TextBlock Classes="title" Text="More data display" />
            <TextBlock Classes="hint" Text="Kbd, copy button, stat card, link card, tree view, timeline, aspect ratio and wrap layout." />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:ShellLabel Text="Open search with" Size="Sm" Variant="Muted" VerticalAlignment="Center" />
                <ui:Kbd Text="Ctrl" />
                <ui:Kbd Text="K" />
                <ui:ShellLabel Text="or close with" Size="Sm" Variant="Muted" VerticalAlignment="Center" />
                <ui:Kbd Text="Esc" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <Border BorderThickness="1" CornerRadius="6" Padding="12,4,4,4" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource ShellUIBorderBrush}" Background="{DynamicResource ShellUIMutedBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="shellui-native add button" FontFamily="Consolas,Menlo,monospace" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellUIForegroundBrush}" />
                        <ui:CopyButton x:Name="CopyCommand" Text="shellui-native add button" />
                    </StackPanel>
                </Border>
                <ui:CopyButton x:Name="CopyLink" Text="https://shellui.dev" Label="Copy link" />
            </StackPanel>
            <ui:WrapLayout Spacing="12" LineSpacing="12" Margin="0,12,0,0">
                <ui:StatCard Title="Total revenue" Value="$45,231.89" Change="+20.1%" Trend="Up" Icon="DollarSign"
                             Description="from last month" Width="230" />
                <ui:StatCard Title="Churn" Value="2.4%" Change="-0.6%" Trend="Down" Icon="Users"
                             Description="from last month" Width="230" />
                <ui:StatCard Title="Active now" Value="573" Change="steady" Icon="Activity" Width="230" />
            </ui:WrapLayout>
            <StackPanel Spacing="12" Width="420" HorizontalAlignment="Left" Margin="0,12,0,0">
                <ui:LinkCard x:Name="DocsCard" Title="Documentation" Description="Guides, theming and the full component reference."
                             Icon="FileText" Url="https://shellui.dev" />
                <ui:LinkCard x:Name="SourceCard" Title="Source on GitHub" Description="Browse the code, report issues and contribute."
                             Icon="Code" Url="https://github.com/shellui-dev/shellui-native" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,16,0,0">
                <ui:TreeView x:Name="FileTree" SelectedValue="MainWindow.axaml" Width="300" VerticalAlignment="Top">
                    <ui:TreeViewItem Text="src" Icon="Folder" IsExpanded="True">
                        <ui:TreeViewItem Text="Components" Icon="Folder" IsExpanded="True">
                            <ui:TreeViewItem Text="Button.cs" Icon="File" />
                            <ui:TreeViewItem Text="Card.cs" Icon="File" />
                            <ui:TreeViewItem Text="Dialog.cs" Icon="File" />
                        </ui:TreeViewItem>
                        <ui:TreeViewItem Text="Assets" Icon="Folder">
                            <ui:TreeViewItem Text="icon.ico" Icon="Image" />
                        </ui:TreeViewItem>
                        <ui:TreeViewItem Text="MainWindow.axaml" Icon="FileText" />
                        <ui:TreeViewItem Text="App.axaml" Icon="FileText" />
                    </ui:TreeViewItem>
                    <ui:TreeViewItem Text="README.md" Icon="FileText" />
                </ui:TreeView>
                <ui:Timeline Width="380" VerticalAlignment="Top">
                    <ui:TimelineItem Title="Order placed" Time="09:12" Text="We received your order and sent a confirmation." />
                    <ui:TimelineItem Title="Payment confirmed" Time="09:14" Icon="CreditCard" Text="Charged to the card ending in 4242." />
                    <ui:TimelineItem Title="Shipped" Time="14:40" Icon="Send" IsActive="True">
                        <StackPanel Spacing="8">
                            <ui:ShellLabel Text="Your parcel is on its way." Size="Sm" Variant="Muted" />
                            <ui:Badge Text="In transit" Variant="Info" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ui:TimelineItem>
                    <ui:TimelineItem Title="Delivered" Text="Expected tomorrow." />
                </ui:Timeline>
            </StackPanel>
            <ui:AspectRatio Ratio="1.7778" Width="360" CornerRadius="8" HorizontalAlignment="Left" Margin="0,16,0,0"
                            Background="{DynamicResource ShellUIMutedBrush}">
                <TextBlock Text="16 : 9" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ShellUIMutedForegroundBrush}" />
            </ui:AspectRatio>
            <TextBlock x:Name="DisplayChoice" Classes="hint" Margin="0,8,0,0" Text="Copy something, click a card or pick a file." />

            <TextBlock Classes="title" Text="Layout and navigation" />
            <TextBlock Classes="hint" Text="Navbar, sidebar and resizable panels." />
            <Border x:Name="NavbarFrame" BorderThickness="1" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource ShellUIBorderBrush}"
                    Width="720" HorizontalAlignment="Left">
                <ui:Navbar x:Name="DemoNavbar" Title="ShellUI Native" Icon="Sparkles" SelectedValue="docs">
                    <ui:NavbarItem Value="docs" Text="Docs" />
                    <ui:NavbarItem Value="components" Text="Components" />
                    <ui:NavbarItem Value="themes" Text="Themes" />
                    <ui:Navbar.Actions>
                        <ui:Button Icon="Search" Size="Icon" Variant="Ghost" />
                    </ui:Navbar.Actions>
                </ui:Navbar>
            </Border>
            <Border BorderThickness="1" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource ShellUIBorderBrush}"
                    Width="720" Height="340" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*">
                    <ui:Sidebar x:Name="DemoSidebar" SelectedValue="home">
                        <ui:Sidebar.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,6">
                                <ui:Icon Kind="Sparkles" Size="20" VerticalAlignment="Center" />
                                <ui:ShellLabel x:Name="SidebarBrand" Text="ShellUI Native" Size="Sm" Weight="Semibold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Sidebar.Header>
                        <ui:SidebarGroup Label="Workspace">
                            <ui:SidebarItem Value="home" Text="Home" Icon="House" />
                            <ui:SidebarItem Value="inbox" Text="Inbox" Icon="Inbox" Badge="12" />
                            <ui:SidebarItem Value="dashboard" Text="Dashboard" Icon="LayoutDashboard" />
                        </ui:SidebarGroup>
                        <ui:SidebarGroup Label="Account">
                            <ui:SidebarItem Value="settings" Text="Settings" Icon="Settings" />
                            <ui:SidebarItem x:Name="SidebarLogOut" Text="Log out" Icon="LogOut" />
                        </ui:SidebarGroup>
                    </ui:Sidebar>
                    <StackPanel Grid.Column="1" Margin="16" Spacing="12">
                        <ui:Button x:Name="SidebarToggle" Icon="PanelLeft" Size="Icon" Variant="Outline" />
                        <TextBlock x:Name="SidebarPage" Text="Home" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource ShellUIForegroundBrush}" />
                        <ui:ShellLabel Text="Pick a page in the sidebar, or collapse it to a rail of icons." Size="Sm" Variant="Muted" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border BorderThickness="1" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource ShellUIBorderBrush}"
                    Width="560" Height="220" HorizontalAlignment="Left" Margin="0,12,0,0">
                <ui:Resizable x:Name="DemoResizable">
                    <ui:ResizablePanel x:Name="ResizableFirst" Size="1" MinSize="100">
                        <TextBlock Text="One" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellUIForegroundBrush}" />
                    </ui:ResizablePanel>
                    <ui:ResizablePanel Size="2" MinSize="140">
                        <ui:Resizable x:Name="InnerResizable" Orientation="Vertical">
                            <ui:ResizablePanel Size="1">
                                <TextBlock Text="Two" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ShellUIForegroundBrush}" />
                            </ui:ResizablePanel>
                            <ui:ResizablePanel Size="2">
                                <TextBlock Text="Three" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ShellUIForegroundBrush}" />
                            </ui:ResizablePanel>
                        </ui:Resizable>
                    </ui:ResizablePanel>
                </ui:Resizable>
            </Border>
            <TextBlock x:Name="LayoutChoice" Classes="hint" Margin="0,8,0,0" Text="Pick a link or a page, or drag a divider." />

            <TextBlock Classes="title" Text="Groups and menus" />
            <TextBlock Classes="hint" Text="Button group, input group and menubar." />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ui:ButtonGroup x:Name="DemoButtonGroup">
                    <ui:Button x:Name="GroupDay" Text="Day" Variant="Outline" />
                    <ui:Button x:Name="GroupWeek" Text="Week" Variant="Outline" />
                    <ui:Button x:Name="GroupMonth" Text="Month" Variant="Outline" />
                </ui:ButtonGroup>
                <ui:ButtonGroup>
                    <ui:Button Text="Save" />
                    <ui:Button Icon="ChevronDown" Size="Icon" />
                </ui:ButtonGroup>
                <ui:ButtonGroup Orientation="Vertical">
                    <ui:Button Text="Top" Variant="Outline" />
                    <ui:Button Text="Middle" Variant="Outline" />
                    <ui:Button Text="Bottom" Variant="Outline" />
                </ui:ButtonGroup>
            </StackPanel>
            <StackPanel Spacing="8" Width="360" HorizontalAlignment="Left" Margin="0,12,0,0">
                <ui:InputGroup x:Name="DemoInputSearch" PrefixIcon="Search" Placeholder="Search components..." />
                <ui:InputGroup x:Name="DemoInputUrl" PrefixText="https://" SuffixText=".com" Placeholder="example" />
                <ui:InputGroup PrefixIcon="Mail" Placeholder="you@example.com">
                    <ui:InputGroup.Suffix>
                        <ui:Badge Text="Required" Variant="Secondary" />
                    </ui:InputGroup.Suffix>
                </ui:InputGroup>
            </StackPanel>
            <ui:Menubar x:Name="DemoMenubar" Margin="0,12,0,0">
                <ui:MenubarMenu x:Name="MenuFile" Title="File">
                    <ui:MenubarItem Text="New tab" Shortcut="Ctrl+T" />
                    <ui:MenubarItem Text="New window" Shortcut="Ctrl+N" />
                    <ui:MenubarSeparator />
                    <ui:MenubarItem Text="Print" Icon="FileText" Shortcut="Ctrl+P" />
                </ui:MenubarMenu>
                <ui:MenubarMenu x:Name="MenuEdit" Title="Edit">
                    <ui:MenubarItem Text="Undo" Icon="Undo2" Shortcut="Ctrl+Z" />
                    <ui:MenubarItem Text="Redo" Icon="Redo2" Shortcut="Ctrl+Y" />
                    <ui:MenubarSeparator />
                    <ui:MenubarItem Text="Copy" Icon="Copy" />
                    <ui:MenubarItem Text="Delete" Icon="Trash2" IsDestructive="True" />
                </ui:MenubarMenu>
                <ui:MenubarMenu x:Name="MenuView" Title="View">
                    <ui:MenubarItem Text="Reload" Icon="RefreshCw" />
                    <ui:MenubarItem Text="Full screen" IsEnabled="False" />
                </ui:MenubarMenu>
            </ui:Menubar>
            <TextBlock x:Name="GroupChoice" Classes="hint" Margin="0,8,0,0" Text="Click a button, type in a field or pick a menu item." />

            <TextBlock Classes="title" Text="Command and navigation menu" />
            <TextBlock Classes="hint" Text="A searchable command list, a command palette (Ctrl+K) and a navigation menu." />
            <ui:NavigationMenu x:Name="DemoNavigationMenu">
                <ui:NavigationMenuItem x:Name="NavStart" Title="Getting started">
                    <ui:NavigationMenuLink Title="Introduction" Description="What ShellUI Native is and how it works." Icon="Sparkles" />
                    <ui:NavigationMenuLink Title="Installation" Description="Add the CLI and your first component." Icon="Download" />
                    <ui:NavigationMenuLink Title="Theming" />
                </ui:NavigationMenuItem>
                <ui:NavigationMenuItem x:Name="NavComponents" Title="Components">
                    <ui:NavigationMenuLink Title="Button" Description="Variants, sizes, icons and loading." />
                    <ui:NavigationMenuLink Title="Dialog" Description="A modal window over the page." />
                </ui:NavigationMenuItem>
                <ui:NavigationMenuItem x:Name="NavDocs" Title="Docs" />
            </ui:NavigationMenu>
            <ui:Command x:Name="DemoCommand" Width="420" HorizontalAlignment="Left" Margin="0,12,0,0">
                <ui:CommandGroup Heading="Suggestions">
                    <ui:CommandItem Text="Calendar" Icon="Calendar" Value="calendar" />
                    <ui:CommandItem Text="Search components" Icon="Search" Value="search" Keywords="find lookup" />
                    <ui:CommandItem Text="Launch" Icon="Zap" Value="launch" IsEnabled="False" />
                </ui:CommandGroup>
                <ui:CommandSeparator />
                <ui:CommandGroup Heading="Settings">
                    <ui:CommandItem Text="Profile" Icon="User" Value="profile" Shortcut="Ctrl+P" />
                    <ui:CommandItem Text="Billing" Icon="CreditCard" Value="billing" Shortcut="Ctrl+B" />
                    <ui:CommandItem Text="Settings" Icon="Settings" Value="settings" Shortcut="Ctrl+," Keywords="preferences options" />
                </ui:CommandGroup>
            </ui:Command>
            <ui:Button x:Name="OpenPalette" Text="Open command palette" Icon="Command" Variant="Outline" Margin="0,12,0,0" />
            <ui:CommandPalette x:Name="DemoPalette">
                <ui:CommandGroup Heading="Pages">
                    <ui:CommandItem Text="Home" Icon="House" Value="home" />
                    <ui:CommandItem Text="Inbox" Icon="Inbox" Value="inbox" />
                    <ui:CommandItem Text="Dashboard" Icon="LayoutDashboard" Value="dashboard" />
                </ui:CommandGroup>
                <ui:CommandGroup Heading="Actions">
                    <ui:CommandItem Text="Toggle theme" Icon="Moon" Value="theme" Keywords="dark light" />
                    <ui:CommandItem Text="Log out" Icon="LogOut" Value="logout" />
                </ui:CommandGroup>
            </ui:CommandPalette>
            <TextBlock x:Name="CommandChoice" Classes="hint" Margin="0,8,0,0" Text="Search, pick a command or open a menu." />

            <TextBlock Classes="title" Text="Data table" />
            <TextBlock Classes="hint" Text="Filter, sort by a column, select rows and page through a list." />
            <ui:DataTable x:Name="DemoDataTable" ShowSelection="True" PageSize="5" Width="720" HorizontalAlignment="Left">
                <ui:DataTableColumn Header="Invoice" Property="Number" IsBold="True" Width="110" />
                <ui:DataTableColumn Header="Customer" Property="Customer" Width="1.4*" />
                <ui:DataTableColumn Header="Status" Property="Status" />
                <ui:DataTableColumn Header="Date" Property="Date" Format="MMM d, yyyy" />
                <ui:DataTableColumn Header="Amount" Property="Amount" Format="C" Width="120" HorizontalTextAlignment="End" />
            </ui:DataTable>
            <TextBlock x:Name="DataTableChoice" Classes="hint" Margin="0,8,0,0" Text="Select or click a row." />

            <TextBlock Classes="title" Text="Chat and form" />
            <TextBlock Classes="hint" Text="A conversation with a message box, and form fields with validation messages." />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <ui:Chat x:Name="DemoChat" Width="480" Height="420" VerticalAlignment="Top">
                    <ui:Chat.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:Icon Kind="Sparkles" Size="18" VerticalAlignment="Center" />
                            <ui:ShellLabel Text="ShellUI assistant" Size="Sm" Weight="Semibold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Chat.Header>
                    <ui:ChatMessage Role="System" Text="This conversation is a demo." />
                    <ui:ChatMessage Role="Assistant" Sender="ShellUI" Timestamp="09:41" AvatarText="S" Text="Hi! Ask me about any component." />
                    <ui:ChatMessage Role="User" Sender="Shewart" Timestamp="09:42" AvatarText="SS" Text="How do I add the data table?" />
                    <ui:ChatMessage Role="Assistant" Sender="ShellUI" Timestamp="09:42" AvatarText="S" Text="Run the command below, then bind ItemsSource to your list.">
                        <ui:Kbd Text="shellui-native add data-table" HorizontalAlignment="Left" />
                    </ui:ChatMessage>
                    <ui:Chat.Footer>
                        <ui:ChatInput x:Name="DemoChatInput" />
                    </ui:Chat.Footer>
                </ui:Chat>
                <ui:Form x:Name="DemoForm" Width="360" VerticalAlignment="Top">
                    <ui:FormField x:Name="DemoEmailField" Label="Email" Description="We never share your email." IsRequired="True">
                        <ui:Input x:Name="DemoEmail" Placeholder="you@example.com" />
                    </ui:FormField>
                    <ui:FormField x:Name="DemoPasswordField" Label="Password" Description="At least 8 characters." IsRequired="True">
                        <ui:Input x:Name="DemoPassword" Placeholder="Password" IsPassword="True" />
                    </ui:FormField>
                    <ui:FormField Label="Bio">
                        <ui:Textarea Placeholder="Tell us a little about yourself" />
                    </ui:FormField>
                    <ui:Button x:Name="DemoFormSubmit" Text="Create account" />
                </ui:Form>
            </StackPanel>
            <TextBlock x:Name="ChatFormChoice" Classes="hint" Margin="0,8,0,0" Text="Send a message or submit the form." />

            <TextBlock Classes="title" Text="Theme tokens" />
            <TextBlock Classes="hint" Text="Every color is a token; the toggle swaps the light and dark palettes." />
            <WrapPanel x:Name="Swatches" />

            <TextBlock Classes="title" Text="Icons" />
            <TextBlock Classes="hint" Text="Lucide icons from ShellIcons, drawn as geometry." />
            <WrapPanel x:Name="Icons" />
        </StackPanel>
    </ScrollViewer>
</Window>
